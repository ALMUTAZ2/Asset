rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    function staffPath() {
      return /databases/$(database)/documents/staff_users/$(request.auth.token.username);
    }

    function contractorPath() {
      return /databases/$(database)/documents/contractors/$(request.auth.token.contractorId);
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.type == 'staff'
        && request.auth.token.username is string
        && request.auth.uid == 'staff_' + request.auth.token.username
        && exists(staffPath());
    }

    function staffRole() {
      return get(staffPath()).data.role;
    }

    function isAdmin() {
      return isStaff() && staffRole() == 'admin';
    }

    function canEditInvoices() {
      return isStaff() && staffRole() in ['admin', 'reviewer'];
    }

    function isContractor() {
      return request.auth != null
        && request.auth.token.type == 'contractor'
        && request.auth.token.contractorId is string
        && request.auth.uid == 'contractor_' + request.auth.token.contractorId
        && exists(contractorPath())
        && get(contractorPath()).data.active == true
        && get(contractorPath()).data.name == request.auth.token.name;
    }

    function isValidStaffUser(data) {
      return data.keys().hasAll(['id', 'name', 'username', 'role', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'username', 'role', 'updatedAt'])
        && isValidId(data.id)
        && isValidString(data.name, 1, 120)
        && isValidId(data.username)
        && data.username.size() <= 64
        && data.role in ['admin', 'reviewer', 'viewer']
        && isValidString(data.updatedAt, 1, 64);
    }

    function isValidContractor(data) {
      return data.keys().hasAll(['id', 'name', 'active', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'active', 'updatedAt'])
        && isValidId(data.id)
        && isValidString(data.name, 1, 150)
        && data.active is bool
        && isValidString(data.updatedAt, 1, 64);
    }

    function isValidPhotos(photos) {
      return photos is list
        && photos.size() <= 8
        && (photos.size() == 0 || photos[0] is map);
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
          'id', 'seq', 'wo', 'contractor', 'consultant', 'invoiceDate',
          'workType', 'workDesc', 'equipType', 'funcLoc', 'office',
          'deliveryDate', 'note', 'status', 'quality', 'checklist', 'photos', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'seq', 'wo', 'contractor', 'consultant', 'invoiceDate',
          'workType', 'workDesc', 'equipType', 'funcLoc', 'office',
          'deliveryDate', 'note', 'status', 'quality', 'checklist', 'photos', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.seq is number && data.seq >= 0 && data.seq <= 10000000
        && isValidString(data.wo, 1, 80)
        && isValidString(data.contractor, 1, 150)
        && isValidString(data.consultant, 0, 100)
        && isValidString(data.invoiceDate, 0, 32)
        && isValidString(data.workType, 0, 60)
        && isValidString(data.workDesc, 0, 300)
        && isValidString(data.equipType, 0, 60)
        && isValidString(data.funcLoc, 0, 120)
        && isValidString(data.office, 0, 80)
        && isValidString(data.deliveryDate, 0, 32)
        && isValidString(data.note, 0, 500)
        && data.status in ['معتمد', 'قيد المراجعة', 'ملاحظات معلقة', 'مرفوض']
        && isValidString(data.quality, 0, 80)
        && data.checklist is map
        && isValidPhotos(data.photos)
        && isValidString(data.updatedAt, 1, 64);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'time', 'user', 'action', 'details', 'createdAtMs'])
        && data.keys().hasOnly(['id', 'time', 'user', 'action', 'details', 'createdAtMs'])
        && isValidId(data.id)
        && isValidString(data.time, 1, 64)
        && isValidString(data.user, 1, 160)
        && isValidString(data.action, 1, 120)
        && isValidString(data.details, 0, 500)
        && data.createdAtMs is number;
    }

    function isValidOneDriveSettings(data) {
      return data.keys().hasAll(['clientId', 'tenantId', 'baseFolder', 'connectedUser', 'updatedAt'])
        && data.keys().hasOnly(['clientId', 'tenantId', 'baseFolder', 'connectedUser', 'updatedAt'])
        && isValidString(data.clientId, 0, 128)
        && isValidString(data.tenantId, 0, 128)
        && isValidString(data.baseFolder, 0, 128)
        && isValidString(data.connectedUser, 0, 150)
        && isValidString(data.updatedAt, 1, 64);
    }

    match /staff_users/{username} {
      allow get, list: if isStaff() && request.query.limit <= 500;
      allow create: if isAdmin()
        && isValidId(username)
        && isValidStaffUser(request.resource.data)
        && request.resource.data.username == username;
      allow update: if isAdmin()
        && isValidId(username)
        && isValidStaffUser(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'updatedAt'])
        && (username != '100889' || request.resource.data.role == 'admin');
      allow delete: if isAdmin() && isValidId(username) && username != '100889';
    }

    match /contractors/{contractorId} {
      allow get, list: if isStaff() && request.query.limit <= 500;
      allow create: if isAdmin()
        && isValidId(contractorId)
        && isValidContractor(request.resource.data)
        && request.resource.data.id == contractorId;
      allow update: if isAdmin()
        && isValidId(contractorId)
        && isValidContractor(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(contractorId);
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId)
        && ((isStaff()) || (isContractor() && resource.data.contractor == request.auth.token.name));
      allow list: if request.query.limit <= 5000
        && (isStaff() || (isContractor() && resource.data.contractor == request.auth.token.name));
      allow create: if isValidId(invoiceId)
        && isValidInvoice(request.resource.data)
        && request.resource.data.id == invoiceId
        && (canEditInvoices() || (isContractor()
          && request.resource.data.contractor == request.auth.token.name
          && request.resource.data.status == 'قيد المراجعة'));
      allow update: if isValidId(invoiceId)
        && isValidInvoice(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.seq == resource.data.seq
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'wo', 'contractor', 'consultant', 'invoiceDate', 'workType', 'workDesc',
          'equipType', 'funcLoc', 'office', 'deliveryDate', 'note', 'status',
          'quality', 'checklist', 'photos', 'updatedAt'
        ])
        && (canEditInvoices() || (isContractor()
          && resource.data.contractor == request.auth.token.name
          && request.resource.data.contractor == request.auth.token.name
          && request.resource.data.status == 'قيد المراجعة'));
      allow delete: if isAdmin() && isValidId(invoiceId);
    }

    match /audit_logs/{logId} {
      allow get, list: if isStaff() && request.query.limit <= 200;
      allow create: if isStaff()
        && isValidId(logId)
        && isValidAuditLog(request.resource.data)
        && request.resource.data.id == logId;
      allow update, delete: if false;
    }

    match /app_settings/{settingId} {
      allow get: if isAdmin() && settingId == 'onedrive';
      allow create: if isAdmin()
        && settingId == 'onedrive'
        && isValidOneDriveSettings(request.resource.data);
      allow update: if isAdmin()
        && settingId == 'onedrive'
        && isValidOneDriveSettings(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clientId', 'tenantId', 'baseFolder', 'connectedUser', 'updatedAt'
        ]);
      allow list, delete: if false;
    }

    match /auth_credentials/{credentialId} {
      allow read, write: if false;
    }

    match /auth_login_limits/{limitId} {
      allow read, write: if false;
    }

    match /system_meta/{metaId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
