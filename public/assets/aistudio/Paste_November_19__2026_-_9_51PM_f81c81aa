    function exportVisibleStaffInvoicesExcel() {
      const rows = getFilteredStaffInvoices();
      if (!rows.length) { showToast('لا توجد بيانات ظاهرة في الجدول للتصدير', 'warning'); return; }
      try {
        if (typeof XLSX !== 'undefined') {
          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.json_to_sheet(mapInvoicesForExcel(rows));
          XLSX.utils.book_append_sheet(wb, ws, 'الفواتير_المفلترة');
          const out = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
          triggerBlobDownload(new Blob([out], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), `فواتير_الجدول_${todayISO()}.xlsx`);
          showToast(`تم تصدير ${rows.length} فاتورة ظاهرة إلى ملف Excel بنجاح`, 'success');
          return;
        }
      } catch (err) {
        console.warn('XLSX fallback to CSV:', err);
      }
      // CSV UTF-8 BOM fallback
      const mapped = mapInvoicesForExcel(rows);
      const headers = Object.keys(mapped[0]);
      const csv = '\uFEFF' + [headers.join(','), ...mapped.map(r => headers.map(h => `"${String(r[h]).replace(/"/g, '""')}"`).join(','))].join('\n');
      triggerBlobDownload(new Blob([csv], { type: 'text/csv;charset=utf-8;' }), `فواتير_الجدول_${todayISO()}.csv`);
      showToast(`تم تصدير ${rows.length} فاتورة بنجاح`, 'success');
    }

    function exportFullExcel() {
      try {
        if (typeof XLSX !== 'undefined') {
          const wb = XLSX.utils.book_new();
          // Sheet 1: All Invoices
          XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(mapInvoicesForExcel(appState.invoices)), 'الفواتير_التفصيلية');

          // Sheet 2: Contractors Summary
          const summary = buildContractorScorecardData().map(r => ({
            'المقاول': r.contractor,
            'الإجمالي': r.total,
            'طوارئ': r.emergency,
            'صيانة معدة': r.maintEquip,
            'صيانة مغذي': r.maintFeeder,
            'C4C': r.c4c,
            'معتمد': r.approved,
            'مرفوض/ملاحظات': r.flagged,
            'نسبة الاعتماد %': r.rate + '%'
          }));
          XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(summary), 'ملخص_المقاولين');

          // Sheet 3: Delay Reasons
          const noteCounts = {};
          appState.invoices.filter(x => x.status === 'مرفوض' || x.status === 'ملاحظات معلقة').forEach(x => {
            const n = x.note || 'غير معتمد';
            noteCounts[n] = (noteCounts[n] || 0) + 1;
          });
          const delaySheet = Object.entries(noteCounts).sort((a, b) => b[1] - a[1]).map(([k, v]) => ({ 'سبب التأخير / الملاحظة': k, 'عدد الفواتير': v }));
          XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(delaySheet.length ? delaySheet : [{ 'سبب التأخير / الملاحظة': 'لا توجد ملاحظات', 'عدد الفواتير': 0 }]), 'ملاحظات_التأخير');

          const out = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
          triggerBlobDownload(new Blob([out], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), `تقرير_فواتير_شامل_${todayISO()}.xlsx`);
          showToast('تم تصدير ملف Excel الشامل (3 أوراق) بنجاح', 'success');
          return;
        }
      } catch (err) {
        console.error(err);
      }
      exportVisibleStaffInvoicesExcel();
    }

