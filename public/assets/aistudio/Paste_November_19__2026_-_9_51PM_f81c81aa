<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>منصة متابعة فواتير الصيانة والطوارئ | قسم استلام الأصول</title>

  <!-- Google Font: Cairo -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Cairo', 'sans-serif'] },
          colors: {
            navy: { 50: '#f0f4f9', 100: '#dce5f2', 700: '#163b6b', 800: '#0f2f57', 900: '#0B2545', 950: '#07182e' },
            accent: { 400: '#ff7d3b', 500: '#F26522', 600: '#d95314' }
          }
        }
      }
    };
  </script>

  <!-- Chart.js + DataLabels Plugin -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
  <!-- SheetJS (xlsx) -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- html2pdf.js for Direct PDF Export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #f1f5f9;
      color: #0f172a;
      overflow-x: hidden;
    }

    /* Smooth Scrollbars */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #e2e8f0; border-radius: 99px; }
    ::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: #64748b; }

    /* Animations */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-up { animation: fadeUp 0.35s ease-out both; }

    @keyframes pulseGlow {
      0%, 100% { transform: scale(1); opacity: 0.25; }
      50% { transform: scale(1.08); opacity: 0.4; }
    }
    .hero-glow { animation: pulseGlow 7s ease-in-out infinite; }

    /* Print Styling */
    @media print {
      body * { visibility: hidden; }
      #printArea, #printArea * { visibility: visible; }
      #printArea {
        position: absolute;
        inset: 0;
        width: 100%;
        background: #fff;
        padding: 16px;
      }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- ==================== TOAST CONTAINER ==================== -->
  <div id="toastContainer" class="fixed top-4 left-4 z-[9999] flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

  <!-- ==================== 3-SECOND WELCOME SPLASH ==================== -->
  <div id="welcomeSplash" class="hidden fixed inset-0 z-[9500] bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 flex items-center justify-center p-6">
    <div class="text-center space-y-5 animate-fade-up max-w-md w-full bg-white/10 backdrop-blur-xl border border-white/15 rounded-3xl p-10 shadow-2xl">
      <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-br from-accent-500 to-amber-500 flex items-center justify-center shadow-lg shadow-accent-500/30">
        <i data-lucide="zap" class="w-10 h-10 text-white"></i>
      </div>
      <div class="space-y-2">
        <p class="text-sm font-bold text-accent-400">أهلاً بك في منصة قسم استلام الأصول</p>
        <h2 id="welcomeSplashName" class="text-2xl sm:text-3xl font-black text-white leading-snug">مرحباً</h2>
        <p id="welcomeSplashRole" class="text-xs text-slate-300 font-semibold"></p>
      </div>
      <div class="w-full h-1.5 bg-white/15 rounded-full overflow-hidden">
        <div id="welcomeProgressBar" class="h-full bg-accent-500 rounded-full transition-all duration-[3000ms] ease-linear" style="width: 0%;"></div>
      </div>
      <p class="text-[11px] text-slate-300">جاري تجهيز لوحة العمل الخاصة بك...</p>
    </div>
  </div>

  <!-- ==================== 1. EXECUTIVE SPLIT LOGIN PORTAL ==================== -->
  <section id="loginScreen" class="min-h-screen grid grid-cols-1 lg:grid-cols-12 bg-slate-100">
    <!-- Right Panel (Executive Branding Hero) -->
    <div class="lg:col-span-7 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800 text-white p-8 sm:p-12 lg:p-16 flex flex-col justify-between relative overflow-hidden">
      <!-- Decorative Glows -->
      <div class="hero-glow absolute -top-24 -left-24 w-96 h-96 bg-accent-500/30 rounded-full blur-3xl pointer-events-none"></div>
      <div class="hero-glow absolute -bottom-24 -right-24 w-96 h-96 bg-sky-500/20 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Top Logo & Brand -->
      <div class="relative z-10 flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-accent-500 to-amber-500 flex items-center justify-center shadow-xl shadow-accent-500/30 shrink-0">
          <i data-lucide="zap" class="w-8 h-8 text-white"></i>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-black tracking-tight text-white">منصة متابعة فواتير الصيانة والطوارئ قسم استلام الاصول</h1>
          <p class="text-xs sm:text-sm text-slate-300 font-semibold mt-0.5">بوابة رقمية موحّدة لمتابعة واعتماد فواتير المقاولين</p>
        </div>
      </div>

      <!-- Center Hero Message & 3 Feature Cards -->
      <div class="relative z-10 my-10 space-y-6">
        <div class="space-y-2 max-w-xl">
          <h2 class="text-2xl sm:text-4xl font-black leading-tight text-white">
            متابعة لحظية دقيقة لجميع <span class="text-accent-400">فواتير الصيانة والطوارئ</span>
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            نظام متكامل يربط المقاولين بموظفي قسم استلام الأصول لرفع الفواتير ومراجعتها واعتمادها واستخراج التقارير التنفيذية بدقة وسرعة.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-4 space-y-2 hover:bg-white/15 transition">
            <div class="w-10 h-10 rounded-xl bg-accent-500/20 text-accent-400 flex items-center justify-center">
              <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <h3 class="text-sm font-extrabold text-white">بوابات وصلاحيات معزولة</h3>
            <p class="text-xs text-slate-300 leading-relaxed">شاشة مستقلة لكل مقاول وشاشة متكاملة لموظفي الشركة بصلاحيات مرنة.</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-4 space-y-2 hover:bg-white/15 transition">
            <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-300 flex items-center justify-center">
              <i data-lucide="camera" class="w-5 h-5"></i>
            </div>
            <h3 class="text-sm font-extrabold text-white">إرفاق صور الأعمال وأرشفتها</h3>
            <p class="text-xs text-slate-300 leading-relaxed">توثيق مراحل العمل بالصور مع تنظيم تلقائي لكل مقاول ورقم أمر عمل.</p>
          </div>

          <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-4 space-y-2 hover:bg-white/15 transition">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center">
              <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
            </div>
            <h3 class="text-sm font-extrabold text-white">لوحة تحكم وتقارير تنفيذية</h3>
            <p class="text-xs text-slate-300 leading-relaxed">مؤشرات أداء فورية وتصدير شامل لملفات PDF و Excel حسب الفلاتر.</p>
          </div>
        </div>
      </div>

      <!-- Footer Note -->
      <div class="relative z-10 text-xs text-slate-400 flex items-center justify-between border-t border-white/10 pt-4">
        <span>قسم استلام الأصول — إدارة الصيانة والطوارئ</span>
        <span class="font-bold text-slate-300">منصة متابعة واعتماد الفواتير</span>
      </div>
    </div>

    <!-- Left Panel (Login Card) -->
    <div class="lg:col-span-5 flex items-center justify-center p-6 sm:p-10 lg:p-12">
      <div class="w-full max-w-md bg-white rounded-3xl shadow-xl border border-slate-200/80 p-7 sm:p-9 space-y-6 animate-fade-up">
        <div class="text-center space-y-1.5">
          <h2 class="text-2xl font-black text-navy-900">تسجيل الدخول</h2>
          <p class="text-xs text-slate-500 font-semibold">اختر نوع الحساب للمتابعة إلى المنصة</p>
        </div>

        <!-- Tabs: Company Staff FIRST, then Contractors -->
        <div class="grid grid-cols-2 gap-1.5 p-1.5 bg-slate-100 rounded-2xl border border-slate-200">
          <button type="button" id="tabBtnStaff" onclick="switchLoginTab('staff')"
            class="py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold flex items-center justify-center gap-2 transition bg-navy-900 text-white shadow-sm">
            <i data-lucide="user-check" class="w-4 h-4"></i>
            <span>دخول موظف الشركة</span>
          </button>
          <button type="button" id="tabBtnContractor" onclick="switchLoginTab('contractor')"
            class="py-2.5 px-3 rounded-xl text-xs sm:text-sm font-extrabold flex items-center justify-center gap-2 transition text-slate-600 hover:text-navy-900">
            <i data-lucide="hard-hat" class="w-4 h-4"></i>
            <span>دخول المقاولين</span>
          </button>
        </div>

        <!-- TAB 1: Company Staff Login Form (DEFAULT) -->
        <form id="staffLoginForm" onsubmit="handleStaffLogin(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-extrabold text-navy-900 mb-1.5">الرقم الوظيفي</label>
            <div class="relative">
              <i data-lucide="id-card" class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2"></i>
              <input type="text" id="loginStaffUsername" required placeholder="أدخل الرقم الوظيفي"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15 py-3 pr-10 pl-3.5 text-sm font-bold outline-none transition" dir="ltr" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-extrabold text-navy-900 mb-1.5">الرقم السري</label>
            <div class="relative">
              <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2"></i>
              <input type="password" id="loginStaffPassword" required placeholder="••••••••"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15 py-3 pr-10 pl-3.5 text-sm font-bold outline-none transition" dir="ltr" />
            </div>
          </div>

          <button type="submit"
            class="w-full py-3.5 rounded-xl bg-gradient-to-l from-navy-900 to-navy-800 hover:from-navy-800 hover:to-navy-700 text-white font-extrabold text-sm shadow-lg shadow-navy-900/20 flex items-center justify-center gap-2 transition">
            <span>دخول موظف الشركة</span>
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
          </button>

          <div class="text-center pt-1">
            <button type="button" onclick="openResetPasswordModal()" class="text-xs font-bold text-accent-600 hover:text-accent-500 inline-flex items-center gap-1.5 transition">
              <i data-lucide="key-round" class="w-3.5 h-3.5"></i>
              <span>إعادة تعيين كلمة المرور</span>
            </button>
          </div>
        </form>

        <!-- TAB 2: Contractor Login Form -->
        <form id="contractorLoginForm" onsubmit="handleContractorLogin(event)" class="hidden space-y-4">
          <div>
            <label class="block text-xs font-extrabold text-navy-900 mb-1.5">ابحث واختر اسم المقاول</label>
            <div class="relative mb-2">
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2"></i>
              <input type="text" id="contractorSearchInput" oninput="filterContractorDropdown()" placeholder="ابحث باسم المؤسسة أو الشركة..."
                class="w-full rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-accent-500 py-2.5 pr-10 pl-3 text-xs font-bold outline-none transition" />
            </div>
            <select id="loginContractorSelect" required
              class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15 py-3 px-3.5 text-sm font-bold outline-none transition">
            </select>
          </div>

          <div>
            <label class="block text-xs font-extrabold text-navy-900 mb-1.5">الرقم السري للمقاول</label>
            <div class="relative">
              <i data-lucide="lock" class="w-4 h-4 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2"></i>
              <input type="password" id="loginContractorPin" required placeholder="أدخل الرقم السري"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-navy-900 focus:ring-2 focus:ring-navy-900/15 py-3 pr-10 pl-3.5 text-sm font-bold outline-none transition" dir="ltr" />
            </div>
          </div>

          <button type="submit"
            class="w-full py-3.5 rounded-xl bg-gradient-to-l from-accent-500 to-accent-600 hover:from-accent-600 hover:to-orange-700 text-white font-extrabold text-sm shadow-lg shadow-accent-500/25 flex items-center justify-center gap-2 transition">
            <span>دخول بوابة المقاول</span>
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- ==================== 2. CONTRACTOR PORTAL ==================== -->
  <section id="contractorPortal" class="hidden min-h-screen flex flex-col bg-slate-100">
    <!-- Top Header -->
    <header class="bg-navy-900 text-white shadow-md sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-accent-500 flex items-center justify-center shadow">
            <i data-lucide="hard-hat" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <h1 class="text-sm sm:text-base font-black text-white">بوابة المقاول — متابعة فواتير الصيانة والطوارئ</h1>
            <p class="text-xs text-accent-400 font-bold">مرحباً، <span id="cpContractorName" class="text-white"></span></p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="logout()" class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-rose-600 text-white text-xs font-bold flex items-center gap-1.5 transition">
            <i data-lucide="log-out" class="w-4 h-4"></i>
            <span>تسجيل الخروج</span>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto w-full px-4 sm:px-6 py-6 space-y-6 flex-1">
      <!-- Personal KPIs -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm">
          <p class="text-xs font-bold text-slate-500">إجمالي فواتيري</p>
          <p id="cpKpiTotal" class="text-2xl font-black text-navy-900 mt-1">0</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-emerald-200 shadow-sm">
          <p class="text-xs font-bold text-emerald-700">معتمد</p>
          <p id="cpKpiApproved" class="text-2xl font-black text-emerald-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-sky-200 shadow-sm">
          <p class="text-xs font-bold text-sky-700">قيد المراجعة</p>
          <p id="cpKpiPending" class="text-2xl font-black text-sky-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-rose-200 shadow-sm">
          <p class="text-xs font-bold text-rose-700">مرفوض / ملاحظات</p>
          <p id="cpKpiRejected" class="text-2xl font-black text-rose-600 mt-1">0</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-amber-200 shadow-sm col-span-2 sm:col-span-1">
          <p class="text-xs font-bold text-amber-700">نسبة الاعتماد</p>
          <p id="cpKpiRate" class="text-2xl font-black text-amber-600 mt-1">0%</p>
        </div>
      </div>

      <!-- New / Edit Invoice Form Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-6 space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-accent-500/15 text-accent-600 flex items-center justify-center">
              <i data-lucide="file-plus-2" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 id="cpFormTitle" class="text-base font-black text-navy-900">رفع فاتورة صيانة / طوارئ جديدة</h2>
              <p class="text-xs text-slate-500">قم بتعبئة الحقول وإرفاق صور مراحل التنفيذ لإرسالها لقسم استلام الأصول</p>
            </div>
          </div>
          <button type="button" id="cpCancelEditBtn" onclick="resetContractorForm()" class="hidden px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold">
            إلغاء التعديل
          </button>
        </div>

        <form id="contractorInvoiceForm" onsubmit="handleContractorSubmit(event)" class="space-y-5">
          <input type="hidden" id="cpEditId" value="" />

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Work Order -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">رقم أمر العمل *</label>
              <input type="text" id="cpWo" required oninput="checkDuplicateWO()" placeholder="مثال: 422073943"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white focus:border-navy-900 py-2.5 px-3 text-sm font-bold outline-none" dir="ltr" />
              <p id="cpWoDupWarning" class="hidden text-[11px] font-bold text-rose-600 mt-1 flex items-center gap-1">
                <i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i>
                <span>تنبيه: رقم أمر العمل مسجّل مسبقاً!</span>
              </p>
            </div>

            <!-- Consultant -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">الاستشاري *</label>
              <select id="cpConsultant" required class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none"></select>
            </div>

            <!-- Invoice Date -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">تاريخ الفاتورة *</label>
              <input type="date" id="cpInvoiceDate" required class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none" />
            </div>

            <!-- Work Type -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">نوع العمل *</label>
              <select id="cpWorkType" required class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none"></select>
            </div>

            <!-- Work Description -->
            <div class="sm:col-span-2">
              <label class="block text-xs font-extrabold text-navy-900 mb-1">وصف العمل *</label>
              <input type="text" id="cpWorkDesc" list="workDescList" required placeholder="اختر أو اكتب وصف العمل"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none" />
              <datalist id="workDescList"></datalist>
            </div>

            <!-- Equipment Type -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">نوع المعدة *</label>
              <select id="cpEquipType" required class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none"></select>
            </div>

            <!-- Functional Location -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">الموقع الوظيفي *</label>
              <input type="text" id="cpFuncLoc" required placeholder="مثال: 4400-JHS-090101"
                class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none" dir="ltr" />
            </div>

            <!-- Office -->
            <div>
              <label class="block text-xs font-extrabold text-navy-900 mb-1">المكتب *</label>
              <select id="cpOffice" required class="w-full rounded-xl border border-slate-300 bg-slate-50 focus:bg-white py-2.5 px-3 text-sm font-bold outline-none"></select>
            </div>

            <!-- Delivery Date (Auto Today & Locked) -->
            <div>
