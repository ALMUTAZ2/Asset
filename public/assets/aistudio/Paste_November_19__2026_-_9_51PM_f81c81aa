    // ==================== REPORTS MODULE ====================
    function buildContractorScorecardData() {
      const map = {};
      appState.invoices.forEach(inv => {
        if (!map[inv.contractor]) {
          map[inv.contractor] = { contractor: inv.contractor, total: 0, emergency: 0, maintEquip: 0, maintFeeder: 0, c4c: 0, approved: 0, flagged: 0 };
        }
        const r = map[inv.contractor];
        r.total++;
        if (inv.workType === 'طوارئ') r.emergency++;
        else if (inv.workType === 'صيانة معدة') r.maintEquip++;
        else if (inv.workType === 'صيانة مغذي') r.maintFeeder++;
        else if (inv.workType === 'C4C') r.c4c++;
        if (inv.status === 'معتمد') r.approved++;
        else if (inv.status === 'مرفوض' || inv.status === 'ملاحظات معلقة') r.flagged++;
      });
      return Object.values(map).map(r => ({
        ...r,
        rate: r.total ? Math.round((r.approved / r.total) * 100) : 0
      })).sort((a, b) => b.total - a.total);
    }

    function renderReportsModule() {
      const rows = buildContractorScorecardData();
      document.getElementById('reportsScorecardTbody').innerHTML = rows.map(r => `
        <tr class="hover:bg-slate-50">
          <td class="p-3 font-extrabold text-navy-900">${escapeHtml(r.contractor)}</td>
          <td class="p-3 text-center font-black">${r.total}</td>
          <td class="p-3 text-center">${r.emergency}</td>
          <td class="p-3 text-center">${r.maintEquip}</td>
          <td class="p-3 text-center">${r.maintFeeder}</td>
          <td class="p-3 text-center">${r.c4c}</td>
          <td class="p-3 text-center font-bold text-emerald-600">${r.approved}</td>
          <td class="p-3 text-center font-bold text-rose-600">${r.flagged}</td>
          <td class="p-3 text-center">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold ${r.rate >= 70 ? 'bg-emerald-100 text-emerald-800' : r.rate >= 30 ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'}">${r.rate}%</span>
          </td>
        </tr>
      `).join('');
    }

    // ==================== USERS & PERMISSIONS (ADMIN 100889) ====================
    function renderUsersManagement() {
      const isSuperAdmin = currentSession?.role === 'admin';
      document.getElementById('staffUsersTbody').innerHTML = appState.staff.map((u, idx) => `
        <tr class="hover:bg-slate-50">
          <td class="p-2.5 font-mono font-extrabold text-navy-900">${escapeHtml(u.id)}</td>
          <td class="p-2.5 font-bold">${escapeHtml(u.name)}</td>
          <td class="p-2.5">
            <select ${!isSuperAdmin || u.id === '100889' ? 'disabled' : ''} onchange="updateStaffRole(${idx}, this.value)"
              class="rounded-lg border border-slate-300 bg-white py-1 px-2 text-xs font-bold outline-none disabled:bg-slate-100">
              <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>مدير نظام (كامل)</option>
              <option value="reviewer" ${u.role === 'reviewer' ? 'selected' : ''}>موظف شركة (مراجعة واعتماد)</option>
              <option value="viewer" ${u.role === 'viewer' ? 'selected' : ''}>مراقب (عرض وتقارير)</option>
            </select>
          </td>
          <td class="p-2.5 text-center">
            <button onclick="adminResetStaffPass(${idx})" class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-navy-900 hover:text-white text-[11px] font-bold transition">تعيين 1234</button>
          </td>
        </tr>
      `).join('');

      const q = (document.getElementById('adminContractorSearch').value || '').trim().toLowerCase();
      document.getElementById('contractorsDirTbody').innerHTML = appState.contractors
        .map((c, idx) => ({ c, idx }))
        .filter(({ c }) => c.name.toLowerCase().includes(q))
        .map(({ c, idx }) => `
          <tr class="hover:bg-slate-50">
            <td class="p-2.5 font-bold text-navy-900">${escapeHtml(c.name)}</td>
            <td class="p-2.5 text-center">
              <input type="text" value="${escapeHtml(c.pin)}" onchange="updateContractorPin(${idx}, this.value)"
                class="w-20 text-center rounded-lg border border-slate-300 bg-slate-50 py-1 px-1.5 font-mono font-bold text-xs" dir="ltr" />
            </td>
            <td class="p-2.5 text-center">
              <button onclick="toggleContractorActive(${idx})" class="px-2.5 py-1 rounded-full text-[11px] font-extrabold ${c.active ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                ${c.active ? 'نشط' : 'موقوف'}
              </button>
            </td>
          </tr>
        `).join('');

      document.getElementById('auditLogTbody').innerHTML = appState.auditLog.slice(0, 60).map(l => `
        <tr>
          <td class="p-2.5 font-mono text-slate-500">${escapeHtml(l.time)}</td>
          <td class="p-2.5 font-bold text-navy-900">${escapeHtml(l.user)}</td>
          <td class="p-2.5 font-extrabold text-accent-600">${escapeHtml(l.action)}</td>
          <td class="p-2.5 text-slate-600">${escapeHtml(l.details)}</td>
        </tr>
      `).join('');
    }

    function updateStaffRole(idx, newRole) {
      const u = appState.staff[idx];
      if (!u) return;
      u.role = newRole;
      saveState();
      logAudit('تعديل صلاحية موظف', `${u.name} (${u.id}) ← ${newRole}`);
      showToast(`تم تحديث صلاحية ${u.name} بنجاح`, 'success');
    }

    function adminResetStaffPass(idx) {
      const u = appState.staff[idx];
      if (!u) return;
      u.password = '1234';
      saveState();
      logAudit('إعادة تعيين كلمة سر موظف', `${u.name} (${u.id})`);
      showToast(`تم إعادة تعيين كلمة سر ${u.name} إلى 1234`, 'info');
    }

    function updateContractorPin(idx, newPin) {
      const pin = String(newPin || '').trim();
      if (!pin) return;
      appState.contractors[idx].pin = pin;
      saveState();
      logAudit('تعديل الرقم السري لمقاول', `${appState.contractors[idx].name}`);
      showToast(`تم حفظ الرقم السري الجديد لـ ${appState.contractors[idx].name}`, 'success');
    }

    function toggleContractorActive(idx) {
      const c = appState.contractors[idx];
      c.active = !c.active;
      saveState();
      logAudit('تغيير حالة مقاول', `${c.name} ← ${c.active ? 'نشط' : 'موقوف'}`);
      renderUsersManagement();
    }

    function openAddContractorModal() {
      document.getElementById('ncName').value = '';
      document.getElementById('ncPin').value = String(1001 + appState.contractors.length);
      openModal('addContractorModal');
    }

    function handleAddContractor(e) {
      e.preventDefault();
      const name = document.getElementById('ncName').value.trim();
      const pin = document.getElementById('ncPin').value.trim();
      if (!name || appState.contractors.some(c => c.name === name)) {
        showToast('اسم المقاول موجود مسبقاً أو غير صالح', 'error');
        return;
      }
      appState.contractors.push({ name, pin, active: true });
      saveState();
      populateStaticSelects();
      logAudit('إضافة مقاول جديد', name);
      closeModal('addContractorModal');
      showToast(`تمت إضافة ${name} بنجاح`, 'success');
      renderUsersManagement();
    }

    // ==================== DROPBOX CLOUD INTEGRATION ====================
    function renderDropboxSettings() {
      document.getElementById('odClientId').value = appState.oneDrive.clientId || '';
      document.getElementById('odBaseFolder').value = appState.oneDrive.baseFolder || '/فواتير_الصيانة_والطوارئ';
      document.getElementById('odAccessToken').value = appState.oneDrive.accessToken || '';

      const badge = document.getElementById('odStatusBadge');
      if (appState.oneDrive.accessToken) {
        badge.className = 'text-xs font-extrabold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800';
        badge.textContent = appState.oneDrive.connectedEmail ? `متصل (${appState.oneDrive.connectedEmail})` : 'متصل بـ Dropbox';
      } else {
        badge.className = 'text-xs font-extrabold px-3 py-1 rounded-full bg-amber-100 text-amber-800';
        badge.textContent = 'غير متصل';
      }

      // Visual Folder Tree: Base Folder -> Contractor Name -> Work Order Number -> Photos
      const base = '/' + String(appState.oneDrive.baseFolder || '/فواتير_الصيانة_والطوارئ').replace(/^\/+|\/+$/g, '');
      const tree = {};
      let totalPhotos = 0;
      appState.invoices.forEach(inv => {
        if (inv.photos && inv.photos.length) {
          const cName = sanitizeDropboxSegment(inv.contractor, 'مقاول');
          const pName = sanitizeDropboxSegment(inv.wo, 'مشروع');
          if (!tree[cName]) tree[cName] = {};
          if (!tree[cName][pName]) tree[cName][pName] = [];
          inv.photos.forEach(p => {
            p.projectName = pName;
            p.oneDrivePath = buildDropboxPhotoPath(inv.contractor, inv.wo, p.name);
            tree[cName][pName].push(p);
            totalPhotos++;
          });
        }
      });

      document.getElementById('odTotalPhotosCount').textContent = totalPhotos;
      const lines = [`<div class="text-amber-400 font-bold">📁 Dropbox${escapeHtml(base)}</div>`];
      Object.entries(tree).forEach(([cName, projects]) => {
        lines.push(`<div class="pl-4 text-sky-300 font-bold">├─ 📂 ${escapeHtml(cName)}</div>`);
        Object.entries(projects).forEach(([woFolder, photos]) => {
          lines.push(`<div class="pl-8 text-emerald-300">├─ 📂 ${escapeHtml(woFolder)}</div>`);
          photos.forEach(p => {
            lines.push(`<div class="pl-12 text-slate-300 text-[11px]">└─ 🖼️ ${escapeHtml(p.name)} ${p.synced ? '✅' : '⏳'}</div>`);
          });
        });
      });
      document.getElementById('odFolderTreePreview').innerHTML = lines.join('');
    }

    function saveOneDriveConfig() {
      appState.oneDrive.clientId = document.getElementById('odClientId').value.trim();
      appState.oneDrive.baseFolder = document.getElementById('odBaseFolder').value.trim() || '/فواتير_الصيانة_والطوارئ';
      appState.oneDrive.accessToken = document.getElementById('odAccessToken').value.trim();
      saveState();
      renderDropboxSettings();
      showToast('تم حفظ إعدادات Dropbox بنجاح', 'success');
    }

    function connectOneDriveOAuth() {
      const appKey = document.getElementById('odClientId').value.trim();
      if (!appKey) { showToast('يرجى إدخال مفتاح تطبيق Dropbox (App Key) أولاً', 'warning'); return; }
      const redirectUri = encodeURIComponent(window.location.href.split('#')[0]);
      window.open(`https://www.dropbox.com/oauth2/authorize?client_id=${encodeURIComponent(appKey)}&response_type=token&redirect_uri=${redirectUri}`, '_blank', 'width=600,height=700');
      showToast('تم فتح نافذة تفويض Dropbox', 'info');
    }

    async function verifyOneDriveToken() {
      saveOneDriveConfig();
      const token = appState.oneDrive.accessToken;
      if (!token) { showToast('يرجى إدخال رمز الوصول (Access Token) أولاً', 'warning'); return; }
      try {
        const res = await fetch('https://api.dropboxapi.com/2/users/get_current_account', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('Unauthorized');
        const info = await res.json();
        appState.oneDrive.connectedEmail = info.email || info.name?.display_name || 'Dropbox';
        saveState();
        renderDropboxSettings();
        showToast(`تم الاتصال بنجاح بحساب Dropbox (${appState.oneDrive.connectedEmail})`, 'success');
      } catch {
        showToast('تعذر التحقق من رمز Dropbox، تأكد من صحة Access Token والصلاحيات', 'error');
      }
    }

    async function ensureDropboxFolder(path) {
      try {
        await fetch('https://api.dropboxapi.com/2/files/create_folder_v2', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${appState.oneDrive.accessToken}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ path, autorename: false })
        });
      } catch {}
    }

    async function uploadSinglePhotoToDropbox(photoObj) {
      if (!appState.oneDrive.accessToken || !photoObj?.dataUrl) return false;
      try {
        const fullPath = photoObj.oneDrivePath;
        const folderPath = fullPath.substring(0, fullPath.lastIndexOf('/'));
        await ensureDropboxFolder(folderPath);
        const blob = await (await fetch(photoObj.dataUrl)).blob();
        const res = await fetch('https://content.dropboxapi.com/2/files/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${appState.oneDrive.accessToken}`,
            'Dropbox-API-Arg': JSON.stringify({ path: fullPath, mode: 'overwrite', autorename: true }),
            'Content-Type': 'application/octet-stream'
          },
          body: blob
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    async function syncLocalPhotosToOneDrive() {
      if (!appState.oneDrive.accessToken) {
        showToast('يرجى ربط حساب Dropbox وإدخال Access Token أولاً', 'warning');
        return;
      }
      let syncedCount = 0;
      showToast('جاري مزامنة الصور المحلية إلى Dropbox...', 'info');
      for (const inv of appState.invoices) {
        for (const p of (inv.photos || [])) {
          if (!p.synced) {
            p.oneDrivePath = buildDropboxPhotoPath(inv.contractor, inv.wo, p.name);
            const ok = await uploadSinglePhotoToDropbox(p);
            if (ok) { p.synced = true; syncedCount++; }
          }
        }
      }
      saveState();
      renderDropboxSettings();
      showToast(syncedCount ? `تمت مزامنة ${syncedCount} صورة إلى Dropbox بنجاح` : 'لا توجد صور غير متزامنة أو تعذر الاتصال', syncedCount ? 'success' : 'info');
    }

    // Capture Dropbox OAuth token from URL hash if redirected back
    function checkDropboxOAuthHash() {
      if (window.location.hash && window.location.hash.includes('access_token=')) {
        const params = new URLSearchParams(window.location.hash.slice(1));
        const tok = params.get('access_token');
        if (tok) {
          appState.oneDrive.accessToken = tok;
          saveState();
          history.replaceState(null, '', window.location.pathname);
          showToast('تم استلام رمز الدخول من Dropbox بنجاح', 'success');
        }
      }
    }

    // ==================== INITIALIZATION ====================
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      checkDropboxOAuthHash();
      populateStaticSelects();
      switchLoginTab('staff');
      lucide.createIcons();
    });
  </script>
