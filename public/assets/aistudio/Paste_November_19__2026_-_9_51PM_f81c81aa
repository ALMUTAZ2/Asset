    function renderDashboardCharts(data) {
      const darkTooltip = {
        backgroundColor: '#0B2545',
        titleColor: '#ffffff',
        bodyColor: '#f1f5f9',
        titleFont: { family: 'Cairo', size: 12, weight: 'bold' },
        bodyFont: { family: 'Cairo', size: 12 },
        padding: 10,
        cornerRadius: 10,
        rtl: true
      };

      const pillBadge = (color = '#0B2545', bg = '#f1f5f9', border = '#cbd5e1') => ({
        anchor: 'end',
        align: 'end',
        offset: 6,
        color,
        backgroundColor: bg,
        borderColor: border,
        borderWidth: 1,
        borderRadius: 99,
        padding: { top: 2, bottom: 2, left: 7, right: 7 },
        font: { family: 'Cairo', size: 11, weight: '800' },
        textAlign: 'center'
      });

      // 1. Work Types Doughnut + 2x2 Breakdown Cards
      const wtDefs = [
        { key: 'طوارئ', color: '#F26522' },
        { key: 'صيانة معدة', color: '#0B2545' },
        { key: 'C4C', color: '#0ea5e9' },
        { key: 'صيانة مغذي', color: '#f59e0b' }
      ];
      const wtCounts = wtDefs.map(d => data.filter(x => x.workType === d.key).length);
      document.getElementById('workTypesCenterTotal').textContent = data.length;
      document.getElementById('workTypesLegendGrid').innerHTML = wtDefs.map((d, idx) => {
        const cnt = wtCounts[idx];
        const pct = data.length ? Math.round((cnt / data.length) * 100) : 0;
        return `
          <div class="flex items-center justify-between p-3.5 rounded-2xl border border-slate-200 bg-slate-50/70">
            <div class="flex items-center gap-2.5">
              <span class="w-3.5 h-3.5 rounded-full shrink-0" style="background:${d.color}"></span>
              <span class="text-xs font-extrabold text-navy-900">${d.key}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sm font-black text-navy-900">${cnt}</span>
              <span class="text-[11px] font-bold text-slate-500">(${pct}%)</span>
            </div>
          </div>
        `;
      }).join('');

      destroyChart('workTypes');
      charts.workTypes = new Chart(document.getElementById('chartWorkTypes'), {
        type: 'doughnut',
        data: {
          labels: wtDefs.map(d => d.key),
          datasets: [{ data: wtCounts, backgroundColor: wtDefs.map(d => d.color), borderWidth: 3, borderColor: '#ffffff' }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '66%',
          plugins: {
            legend: { display: false },
            datalabels: { display: false },
            tooltip: darkTooltip
          }
        }
      });

      // 2. Contractors Stacked Bar (Sorted ASCENDING dynamically, Legend at BOTTOM, Total Pill Badge at end)
      const cMap = {};
      data.forEach(inv => {
        if (!cMap[inv.contractor]) cMap[inv.contractor] = { approved: 0, pending: 0, flagged: 0, total: 0 };
        cMap[inv.contractor].total++;
        if (inv.status === 'معتمد') cMap[inv.contractor].approved++;
        else if (inv.status === 'قيد المراجعة') cMap[inv.contractor].pending++;
        else cMap[inv.contractor].flagged++;
      });
      const cEntries = Object.entries(cMap).sort((a, b) => a[1].total - b[1].total);
      const maxCTotal = Math.max(10, ...cEntries.map(e => e[1].total));

      destroyChart('contractors');
      charts.contractors = new Chart(document.getElementById('chartContractors'), {
        type: 'bar',
        data: {
          labels: cEntries.map(e => e[0]),
          datasets: [
            { label: 'معتمد', data: cEntries.map(e => e[1].approved), backgroundColor: '#10b981', borderRadius: 4, datalabels: { display: (ctx) => ctx.dataset.data[ctx.dataIndex] >= 12, color: '#fff', font: { family: 'Cairo', size: 10, weight: 'bold' } } },
            { label: 'قيد المراجعة', data: cEntries.map(e => e[1].pending), backgroundColor: '#0ea5e9', borderRadius: 4, datalabels: { display: (ctx) => ctx.dataset.data[ctx.dataIndex] >= 12, color: '#fff', font: { family: 'Cairo', size: 10, weight: 'bold' } } },
            {
              label: 'مرفوض/ملاحظات',
              data: cEntries.map(e => e[1].flagged),
              backgroundColor: '#f43f5e',
              borderRadius: 4,
              datalabels: {
                display: true,
                ...pillBadge('#0B2545', '#f1f5f9', '#cbd5e1'),
                formatter: (_v, ctx) => cEntries[ctx.dataIndex][1].total
              }
            }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { left: 38, right: 10 } },
          scales: {
            x: { stacked: true, suggestedMax: Math.ceil(maxCTotal * 1.15), grid: { color: '#f1f5f9' }, ticks: { font: { family: 'Cairo', size: 11 }, maxRotation: 0 } },
            y: { stacked: true, grid: { display: false }, ticks: { font: { family: 'Cairo', size: 11, weight: 'bold' }, color: '#0B2545' } }
          },
          plugins: {
            legend: { position: 'bottom', labels: { font: { family: 'Cairo', size: 12, weight: 'bold' }, usePointStyle: true, padding: 16 } },
            tooltip: darkTooltip
          }
        }
      });

      // 3. Offices Bar Chart
      const oMap = {};
      data.forEach(inv => { const o = inv.office || 'غير محدد'; oMap[o] = (oMap[o] || 0) + 1; });
      const oEntries = Object.entries(oMap).sort((a, b) => b[1] - a[1]);
      const maxO = Math.max(10, ...oEntries.map(e => e[1]));

      destroyChart('offices');
      charts.offices = new Chart(document.getElementById('chartOffices'), {
        type: 'bar',
        data: {
          labels: oEntries.map(e => e[0]),
          datasets: [{ label: 'عدد الفواتير', data: oEntries.map(e => e[1]), backgroundColor: '#0B2545', borderRadius: 8, maxBarThickness: 38 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { top: 26 } },
          scales: {
            y: { suggestedMax: Math.ceil(maxO * 1.18), grid: { color: '#f1f5f9' }, ticks: { font: { family: 'Cairo', size: 11 } } },
            x: { grid: { display: false }, ticks: { font: { family: 'Cairo', size: 11, weight: 'bold' }, color: '#0B2545' } }
          },
          plugins: {
            legend: { display: false },
            tooltip: darkTooltip,
            datalabels: { ...pillBadge('#0B2545', '#f1f5f9', '#cbd5e1'), anchor: 'end', align: 'top', offset: 4 }
          }
        }
      });

      // 4. Work Descriptions Horizontal Bar
      const dMap = {};
      data.forEach(inv => { const d = inv.workDesc || 'غير محدد'; dMap[d] = (dMap[d] || 0) + 1; });
      const dEntries = Object.entries(dMap).sort((a, b) => b[1] - a[1]).slice(0, 8);
      const maxD = Math.max(10, ...dEntries.map(e => e[1]));

      destroyChart('workDescs');
      charts.workDescs = new Chart(document.getElementById('chartWorkDescs'), {
        type: 'bar',
        data: {
          labels: dEntries.map(e => e[0]),
          datasets: [{ label: 'التكرار', data: dEntries.map(e => e[1]), backgroundColor: '#F26522', borderRadius: 6, maxBarThickness: 22 }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { left: 36 } },
          scales: {
            x: { suggestedMax: Math.ceil(maxD * 1.18), grid: { color: '#f1f5f9' }, ticks: { font: { family: 'Cairo', size: 11 }, maxRotation: 0 } },
            y: { grid: { display: false }, ticks: { font: { family: 'Cairo', size: 11, weight: 'bold' }, color: '#0B2545' } }
          },
          plugins: {
            legend: { display: false },
            tooltip: darkTooltip,
            datalabels: pillBadge('#c2410c', '#fff7ed', '#fed7aa')
          }
        }
      });

      // 5. Top Delay Reasons Chart
      const flaggedRows = data.filter(x => x.status === 'مرفوض' || x.status === 'ملاحظات معلقة');
      const noteMap = {};
      flaggedRows.forEach(inv => {
        const n = (inv.note && inv.note !== 'قيد المراجعة' && inv.note !== 'تم') ? inv.note : 'غير معتمد';
        noteMap[n] = (noteMap[n] || 0) + 1;
      });
      const topNotes = Object.entries(noteMap).sort((a, b) => b[1] - a[1]).slice(0, 5);
      const maxN = Math.max(5, ...topNotes.map(e => e[1]));

      destroyChart('topDelayNotes');
      charts.topDelayNotes = new Chart(document.getElementById('chartTopDelayNotes'), {
        type: 'bar',
        data: {
          labels: topNotes.length ? topNotes.map(e => e[0]) : ['لا توجد ملاحظات'],
          datasets: [{
            label: 'عدد الفواتير',
            data: topNotes.length ? topNotes.map(e => e[1]) : [0],
            backgroundColor: ['#e11d48', '#f43f5e', '#fb7185', '#f97316', '#f59e0b'],
            borderRadius: 7,
            maxBarThickness: 26
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { left: 38 } },
          scales: {
            x: { suggestedMax: Math.ceil(maxN * 1.2), grid: { color: '#f1f5f9' }, ticks: { font: { family: 'Cairo', size: 11 }, maxRotation: 0, precision: 0 } },
            y: { grid: { display: false }, ticks: { font: { family: 'Cairo', size: 11, weight: 'bold' }, color: '#0B2545' } }
          },
          plugins: {
            legend: { display: false },
            tooltip: darkTooltip,
            datalabels: pillBadge('#be123c', '#fff1f2', '#fecdd3')
          }
        }
      });

      // 6. Delay Reasons by Contractor (Top 5 Contractors with Most Notes)
      const cDelayMap = {};
      flaggedRows.forEach(inv => {
        if (!cDelayMap[inv.contractor]) cDelayMap[inv.contractor] = { total: 0, notes: {} };
        const n = (inv.note && inv.note !== 'قيد المراجعة' && inv.note !== 'تم') ? inv.note : 'غير معتمد';
        cDelayMap[inv.contractor].total++;
        cDelayMap[inv.contractor].notes[n] = (cDelayMap[inv.contractor].notes[n] || 0) + 1;
      });
      const top5DelayContractors = Object.entries(cDelayMap).sort((a, b) => b[1].total - a[1].total).slice(0, 5);
      const maxDC = Math.max(5, ...top5DelayContractors.map(e => e[1].total));

      destroyChart('delayByContractor');
      charts.delayByContractor = new Chart(document.getElementById('chartDelayByContractor'), {
        type: 'bar',
        data: {
          labels: top5DelayContractors.length ? top5DelayContractors.map(([cName, info]) => {
            const topNote = Object.entries(info.notes).sort((a, b) => b[1] - a[1])[0];
            const shortNote = topNote ? (topNote[0].length > 22 ? topNote[0].slice(0, 22) + '...' : topNote[0]) : '';
            return [cName, topNote ? `الأبرز: ${shortNote} (${topNote[1]})` : ''];
          }) : ['لا توجد ملاحظات'],
          datasets: [{
            label: 'عدد الفواتير المتوقفة',
            data: top5DelayContractors.length ? top5DelayContractors.map(e => e[1].total) : [0],
            backgroundColor: ['#0B2545', '#1d4ed8', '#e11d48', '#f97316', '#f59e0b'],
            borderRadius: 7,
            maxBarThickness: 26
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          layout: { padding: { left: 38 } },
          scales: {
            x: { suggestedMax: Math.ceil(maxDC * 1.2), grid: { color: '#f1f5f9' }, ticks: { font: { family: 'Cairo', size: 11 }, maxRotation: 0, precision: 0 } },
            y: { grid: { display: false }, ticks: { font: { family: 'Cairo', size: 10, weight: 'bold' }, color: '#0B2545' } }
          },
          plugins: {
            legend: { display: false },
            datalabels: pillBadge('#0B2545', '#f1f5f9', '#cbd5e1'),
            tooltip: {
              ...darkTooltip,
              callbacks: {
                afterBody: (items) => {
                  const idx = items[0]?.dataIndex;
                  if (idx == null || !top5DelayContractors[idx]) return [];
                  const notesObj = top5DelayContractors[idx][1].notes;
                  return Object.entries(notesObj).sort((a, b) => b[1] - a[1]).map(([k, v]) => `• ${k}: ${v}`);
                }
              }
            }
          }
        }
      });
    }

    // ==================== STAFF INVOICES TABLE & REVIEW ====================
    function getFilteredStaffInvoices() {
      const q = (document.getElementById('invSearch').value || '').trim().toLowerCase();
      const fc = document.getElementById('invFilterContractor').value;
      const fo = document.getElementById('invFilterOffice').value;
      const fw = document.getElementById('invFilterWorkType').value;
      const fst = document.getElementById('invFilterStatus').value;
      const fsla = document.getElementById('invFilterSla').value;
      const fmon = document.getElementById('invFilterMonth').value;

      return appState.invoices.filter(inv => {
        if (fc && inv.contractor !== fc) return false;
        if (fo && inv.office !== fo) return false;
        if (fw && inv.workType !== fw) return false;
        if (fst && inv.status !== fst) return false;
        if (fsla && getInvoiceSlaInfo(inv).label !== fsla) return false;
        if (fmon) {
          const m1 = (inv.invoiceDate || '').slice(0, 7);
          const m2 = (inv.deliveryDate || '').slice(0, 7);
          if (m1 !== fmon && m2 !== fmon) return false;
        }
        if (q) {
          const hay = `${inv.wo} ${inv.contractor} ${inv.funcLoc} ${inv.workDesc} ${inv.office} ${inv.note}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
    }

    function resetStaffInvoicesFilters() {
      ['invSearch', 'invFilterContractor', 'invFilterOffice', 'invFilterWorkType', 'invFilterStatus', 'invFilterSla', 'invFilterMonth'].forEach(id => {
        document.getElementById(id).value = '';
      });
      renderStaffInvoicesTable();
    }

    function renderStaffInvoicesTable() {
      const rows = getFilteredStaffInvoices();
      document.getElementById('invTableCountLabel').textContent = `جميع بيانات الجدول وعددها (${rows.length})`;

      const tbody = document.getElementById('staffInvoicesTbody');
      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="16" class="p-8 text-center text-slate-400 font-bold">لا توجد فواتير مطابقة لمعايير التصفية</td></tr>';
        updateBulkBtnUI();
        return;
      }

      tbody.innerHTML = rows.map(inv => {
        const sla = getInvoiceSlaInfo(inv);
        const photoCount = (inv.photos || []).length;
        const checked = selectedInvoiceIds.has(inv.id) ? 'checked' : '';
        return `
          <tr class="hover:bg-slate-50/90 transition">
            <td class="p-3 text-center">
              <input type="checkbox" ${checked} onchange="toggleSelectInvoice('${inv.id}', this.checked)" class="w-4 h-4 accent-accent-500" />
            </td>
            <td class="p-3 font-mono font-extrabold text-navy-900">${escapeHtml(inv.wo)}</td>
            <td class="p-3 font-bold text-slate-800">${escapeHtml(inv.contractor)}</td>
            <td class="p-3">${escapeHtml(inv.consultant)}</td>
            <td class="p-3 font-mono">${escapeHtml(inv.invoiceDate || '—')}</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded-lg bg-slate-100 font-bold">${escapeHtml(inv.workType)}</span></td>
            <td class="p-3 font-semibold">${escapeHtml(inv.workDesc)}</td>
            <td class="p-3 font-mono font-bold">${escapeHtml(inv.equipType)}</td>
            <td class="p-3 font-mono">${escapeHtml(inv.funcLoc || '—')}</td>
            <td class="p-3 font-semibold">${escapeHtml(inv.office)}</td>
            <td class="p-3 font-mono">${escapeHtml(inv.deliveryDate || '—')}</td>
            <td class="p-3 text-center font-extrabold text-navy-900">${sla.days !== null ? `${sla.days} يوم` : '—'}</td>
            <td class="p-3 text-center"><span class="px-2.5 py-0.5 rounded-full font-extrabold text-[11px] ${sla.cls}">${sla.label}</span></td>
            <td class="p-3">${getStatusBadgeHtml(inv)}</td>
            <td class="p-3 text-center">
              ${photoCount ? `<button onclick="openInvoicePhotosLightbox('${inv.id}')" class="px-2 py-1 rounded-lg bg-sky-100 hover:bg-sky-200 text-sky-800 font-bold text-[11px]">${photoCount} صور</button>` : '<span class="text-slate-400">0</span>'}
            </td>
            <td class="p-3 text-center">
              <button onclick="openReviewModal('${inv.id}')" class="px-3 py-1.5 rounded-lg bg-navy-900 hover:bg-navy-800 text-white font-bold text-[11px] transition">مراجعة</button>
            </td>
          </tr>
        `;
      }).join('');
      updateBulkBtnUI();
    }

    function toggleSelectInvoice(id, isChecked) {
      if (isChecked) selectedInvoiceIds.add(id); else selectedInvoiceIds.delete(id);
      updateBulkBtnUI();
    }

    function toggleSelectAllInvoices(cb) {
      const visible = getFilteredStaffInvoices();
      if (cb.checked) visible.forEach(x => selectedInvoiceIds.add(x.id));
      else visible.forEach(x => selectedInvoiceIds.delete(x.id));
      renderStaffInvoicesTable();
    }

    function updateBulkBtnUI() {
      const btn = document.getElementById('btnBulkApprove');
      const cnt = selectedInvoiceIds.size;
      document.getElementById('selectedRowsCount').textContent = cnt;
      btn.classList.toggle('hidden', cnt === 0 || currentSession?.role === 'viewer');
    }

    function bulkApproveSelected() {
      if (currentSession?.role === 'viewer') return;
      let count = 0;
      appState.invoices.forEach(inv => {
        if (selectedInvoiceIds.has(inv.id)) {
          inv.status = 'معتمد';
          inv.note = 'تم';
          count++;
        }
      });
      selectedInvoiceIds.clear();
      document.getElementById('selectAllInvoices').checked = false;
      saveState();
      logAudit('اعتماد جماعي', `تم اعتماد ${count} فاتورة`);
      showToast(`تم اعتماد ${count} فاتورة بنجاح`, 'success');
      renderStaffInvoicesTable();
    }

    function openReviewModal(invId) {
      const inv = appState.invoices.find(x => x.id === invId);
      if (!inv) return;
      const sla = getInvoiceSlaInfo(inv);
      document.getElementById('rmInvoiceId').value = inv.id;
      document.getElementById('rmTitle').textContent = `مراجعة الفاتورة — أمر عمل #${inv.wo}`;
      document.getElementById('rmSubTitle').textContent = `${inv.contractor} | ${inv.office} | ${inv.workType}`;

      const fields = [
        ['رقم أمر العمل', inv.wo],
        ['المقاول', inv.contractor],
        ['الاستشاري', inv.consultant],
        ['تاريخ الفاتورة', inv.invoiceDate || '—'],
        ['نوع العمل', inv.workType],
        ['وصف العمل', inv.workDesc],
        ['نوع المعدة', inv.equipType],
        ['الموقع الوظيفي', inv.funcLoc || '—'],
        ['المكتب', inv.office],
        ['تاريخ التسليم للأصول', inv.deliveryDate || '—'],
        ['المدة (أيام عمل)', sla.days !== null ? `${sla.days} يوم` : 'تمت المراجعة'],
        ['التصنيف', sla.label]
      ];
      document.getElementById('rmDetailsGrid').innerHTML = fields.map(([k, v]) => `
        <div class="bg-slate-50 rounded-xl p-2.5 border border-slate-200">
          <p class="text-[10px] font-bold text-slate-400">${k}</p>
          <p class="font-extrabold text-navy-900 mt-0.5">${escapeHtml(v)}</p>
        </div>
      `).join('');

      // Photos
      const photosGrid = document.getElementById('rmPhotosGrid');
      if (inv.photos && inv.photos.length) {
        photosGrid.innerHTML = inv.photos.map(p => `
          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm">
            <img src="${p.dataUrl}" onclick="openLightbox('${p.dataUrl}', '${escapeHtml(p.oneDrivePath || p.name)}')" class="w-full h-24 object-cover cursor-pointer" />
            <div class="p-2 space-y-0.5">
              <p class="text-[11px] font-extrabold text-navy-900 truncate">${escapeHtml(p.stage)}</p>
              <p class="text-[10px] font-mono text-sky-700 truncate" dir="ltr" title="${escapeHtml(p.oneDrivePath || '')}">${escapeHtml(p.oneDrivePath || '')}</p>
            </div>
          </div>
        `).join('');
      } else {
        photosGrid.innerHTML = '<p class="col-span-full text-xs text-slate-400 bg-slate-50 p-3 rounded-xl text-center">لا توجد صور مرفقة لهذه الفاتورة</p>';
      }

      document.getElementById('rmStatus').value = inv.status;
      document.getElementById('rmQuality').value = inv.quality || 'ممتاز';
      document.getElementById('rmNote').value = (inv.note && inv.note !== 'قيد المراجعة' && inv.note !== 'تم') ? inv.note : '';

