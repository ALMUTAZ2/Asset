      const d = calcWorkingDays(inv.deliveryDate);
      if (d <= 3) return { days: d, label: 'جديد', cls: 'bg-emerald-100 text-emerald-700' };
      if (d <= 5) return { days: d, label: 'متأخر', cls: 'bg-amber-100 text-amber-800' };
