    // ==================== EXCEL & PDF EXPORTS ====================
    function triggerBlobDownload(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => { document.body.removeChild(a); URL.revokeObjectURL(url); }, 500);
    }

    function mapInvoicesForExcel(rows) {
      return rows.map((inv, idx) => {
        const sla = getInvoiceSlaInfo(inv);
        return {
          'م': idx + 1,
          'رقم أمر العمل': inv.wo,
          'المقاول': inv.contractor,
          'الاستشاري': inv.consultant,
          'تاريخ الفاتورة': inv.invoiceDate || '',
          'نوع العمل': inv.workType,
          'وصف العمل': inv.workDesc,
          'نوع المعدة': inv.equipType,
          'الموقع الوظيفي': inv.funcLoc || '',
          'المكتب': inv.office,
          'تاريخ التسليم للأصول': inv.deliveryDate || '',
          'المدة (أيام عمل)': sla.days !== null ? sla.days : 'تمت المراجعة',
          'التصنيف': sla.label,
          'الحالة': inv.status,
          'الملاحظة / سبب الرفض': inv.note || '',
          'مسار صور Dropbox': (inv.photos || []).map(p => p.oneDrivePath).join(' | ')
        };
      });
