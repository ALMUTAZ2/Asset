    function renderDashboard() {
      const data = getFilteredDashboardInvoices();
      const total = data.length;
      const approved = data.filter(x => x.status === 'معتمد').length;
      const flagged = data.filter(x => x.status === 'مرفوض' || x.status === 'ملاحظات معلقة').length;
      const emergency = data.filter(x => x.workType === 'طوارئ').length;
      const maintenance = data.filter(x => x.workType === 'صيانة معدة' || x.workType === 'صيانة مغذي').length;
      const c4c = data.filter(x => x.workType === 'C4C').length;

      let slaNew = 0, slaLate = 0, slaEscalated = 0;
      data.forEach(inv => {
        const sla = getInvoiceSlaInfo(inv);
        if (sla.label === 'جديد') slaNew++;
        else if (sla.label === 'متأخر') slaLate++;
        else if (sla.label === 'مصعّد') slaEscalated++;
      });

      const appPct = total ? Math.round((approved / total) * 100) : 0;
      const emPct = total ? Math.round((emergency / total) * 100) : 0;

      document.getElementById('kpiTotal').textContent = total;
      document.getElementById('kpiApproved').textContent = approved;
      document.getElementById('kpiApprovedPct').textContent = `نسبة الاعتماد: ${appPct}%`;
      document.getElementById('kpiApprovedBar').style.width = `${appPct}%`;
      document.getElementById('kpiFlagged').textContent = flagged;
      document.getElementById('kpiEmergency').textContent = emergency;
      document.getElementById('kpiEmergencyPct').textContent = `${emPct}% من الإجمالي`;
      document.getElementById('kpiMaintenance').textContent = maintenance;
      document.getElementById('kpiC4c').textContent = c4c;

      document.getElementById('kpiSlaNew').textContent = slaNew;
      document.getElementById('kpiSlaLate').textContent = slaLate;
      document.getElementById('kpiSlaEscalated').textContent = slaEscalated;

      // Active filter hint
      const parts = [];
      const fc = document.getElementById('dashFilterContractor').value;
      const fo = document.getElementById('dashFilterOffice').value;
      const fw = document.getElementById('dashFilterWorkType').value;
      const fcon = document.getElementById('dashFilterConsultant').value;
      const fst = document.getElementById('dashFilterStatus').value;
      if (fc) parts.push(`المقاول: ${fc}`);
      if (fo) parts.push(`المكتب: ${fo}`);
      if (fw) parts.push(`نوع العمل: ${fw}`);
      if (fcon) parts.push(`الاستشاري: ${fcon}`);
      if (fst) parts.push(`الحالة: ${fst}`);
      document.getElementById('dashActiveFilterHint').textContent = parts.length
        ? `نطاق العرض والتصدير الحالي (${total} فاتورة): ${parts.join(' | ')}`
        : `نطاق العرض والتصدير الحالي: جميع الفواتير (${total} فاتورة)`;

      if (activeDrilldownKey) renderDashDrilldown();
      renderDashboardCharts(data);
    }

