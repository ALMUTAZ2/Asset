    function renderDashDrilldown() {
      if (!activeDrilldownKey) return;
      const base = getFilteredDashboardInvoices();
      const map = {
        all: { title: 'إجمالي الفواتير', fn: () => true },
        approved: { title: 'الفواتير المعتمدة', fn: x => x.status === 'معتمد' },
        flagged: { title: 'الفواتير التي عليها ملاحظة / مرفوضة', fn: x => x.status === 'مرفوض' || x.status === 'ملاحظات معلقة' },
        emergency: { title: 'فواتير الطوارئ', fn: x => x.workType === 'طوارئ' },
        maintenance: { title: 'فواتير أعمال الصيانة (معدة + مغذي)', fn: x => x.workType === 'صيانة معدة' || x.workType === 'صيانة مغذي' },
        c4c: { title: 'فواتير أعمال C4C', fn: x => x.workType === 'C4C' },
        sla_new: { title: 'فواتير جديدة (1-3 أيام عمل)', fn: x => getInvoiceSlaInfo(x).label === 'جديد' },
        sla_late: { title: 'فواتير متأخرة (4-5 أيام عمل)', fn: x => getInvoiceSlaInfo(x).label === 'متأخر' },
        sla_escalated: { title: 'فواتير مصعّدة (+5 أيام عمل)', fn: x => getInvoiceSlaInfo(x).label === 'مصعّد' }
      };
      const cfg = map[activeDrilldownKey] || map.all;
      const q = (document.getElementById('dashDrilldownSearch').value || '').trim().toLowerCase();
      const rows = base.filter(x => cfg.fn(x) && (!q || x.wo.toLowerCase().includes(q) || x.contractor.toLowerCase().includes(q) || (x.workDesc || '').toLowerCase().includes(q)));

      document.getElementById('dashDrilldownTitle').textContent = cfg.title;
      document.getElementById('dashDrilldownCount').textContent = rows.length;
      const tbody = document.getElementById('dashDrilldownTbody');
      if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="8" class="p-6 text-center text-slate-400 font-bold">لا توجد فواتير في هذا التصنيف</td></tr>';
        return;
      }
      tbody.innerHTML = rows.slice(0, 120).map(inv => `
        <tr class="hover:bg-slate-50">
          <td class="p-2.5 font-mono font-bold text-navy-900">${escapeHtml(inv.wo)}</td>
          <td class="p-2.5 font-bold">${escapeHtml(inv.contractor)}</td>
          <td class="p-2.5">${escapeHtml(inv.workType)}</td>
          <td class="p-2.5">${escapeHtml(inv.workDesc)}</td>
          <td class="p-2.5">${escapeHtml(inv.office)}</td>
          <td class="p-2.5 font-mono">${escapeHtml(inv.deliveryDate || '—')}</td>
          <td class="p-2.5">${getStatusBadgeHtml(inv)}</td>
          <td class="p-2.5 text-center">
            <button onclick="openReviewModal('${inv.id}')" class="px-2.5 py-1 rounded-lg bg-navy-900 hover:bg-navy-800 text-white text-[11px] font-bold">مراجعة</button>
          </td>
        </tr>
      `).join('');
