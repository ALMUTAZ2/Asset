        deliveryDate: editId ? (document.getElementById('cf_deliveryDate').value || todayISO()) : todayISO(),
        note: document.getElementById('cf_contractorNote').value.trim() || 'قيد المراجعة',
        status: 'قيد المراجعة',
        quality: 'جيد جداً',
        checklist,
        photos: pendingPhotos
      };

      if (editId) {
        const idx = appState.invoices.findIndex(i => i.id === editId);
        if (idx > -1) {
          appState.invoices[idx] = { ...appState.invoices[idx], ...payload };
          logAudit('تعديل فاتورة مقاول', `أمر العمل ${wo} — إعادة إرسال للمراجعة`);
          showToast('تم تحديث وإعادة إرسال الفاتورة بنجاح', 'success');
