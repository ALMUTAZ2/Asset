    // حساب أيام العمل الفعلية من تاريخ التسليم إلى تاريخ اليوم مع استبعاد الجمعة (5) والسبت (6)
    function calcWorkingDays(startDateStr) {
      if (!startDateStr) return 0;
      const parts = String(startDateStr).slice(0, 10).split('-').map(Number);
      if (parts.length !== 3 || parts.some(isNaN)) return 0;
      const start = new Date(parts[0], parts[1] - 1, parts[2]);
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      if (start >= today) return 0;
      let workingDays = 0;
      const cur = new Date(start);
      while (cur < today) {
        cur.setDate(cur.getDate() + 1);
        const day = cur.getDay();
        if (day !== 5 && day !== 6) { // استبعاد إجازة نهاية الأسبوع: الجمعة والسبت
          workingDays++;
        }
      }
      return workingDays;
    }

    // تحديد المدة والتصنيف الآلي للفاتورة التي لم تُراجع بعد
    function getInvoiceSlaInfo(inv) {
      if (inv.status !== 'قيد المراجعة') {
        return {
          reviewed: true,
          days: null,
          daysText: 'تمت المراجعة',
          category: 'تمت المراجعة',
          badgeClass: 'bg-slate-100 text-slate-600 border-slate-200'
        };
      }
      const days = calcWorkingDays(inv.deliveryDate);
      let category = 'جديد';
      let badgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-200';
      if (days >= 4 && days <= 5) {
        category = 'متأخر';
        badgeClass = 'bg-amber-100 text-amber-800 border-amber-300';
      } else if (days > 5) {
        category = 'مصعّد';
        badgeClass = 'bg-rose-100 text-rose-800 border-rose-300';
      }
      const daysText = days === 0 ? 'اليوم (0)' : (days === 1 ? '1 يوم' : (days === 2 ? 'يومان' : `${days} أيام`));
      return { reviewed: false, days, daysText, category, badgeClass };
    }

