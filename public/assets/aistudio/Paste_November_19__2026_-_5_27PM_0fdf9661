            <button onclick="toggleContractorActive('${escapeHtml(c.name)}')" class="text-xs font-bold ${c.active ? 'text-rose-600' : 'text-emerald-600'} hover:underline">${c.active ? 'إيقاف' : 'تفعيل'}</button>
