    function getStandaloneTailwindConfigScript() {
      return `<script>
        tailwind.config = {
          theme: {
            extend: {
              fontFamily: { cairo: ['Cairo', 'sans-serif'] },
              colors: {
                navy: { 50: '#eef3f9', 100: '#d5e2f0', 200: '#abc5e1', 700: '#163b6b', 800: '#0f2f57', 900: '#0B2545', 950: '#07182e' },
