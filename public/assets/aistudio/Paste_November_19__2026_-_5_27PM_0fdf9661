    // Direct Excel (.xlsx) Import via SheetJS
    function formatExcelDate(val) {
      if (!val) return '';
      if (typeof val === 'number') {
        const d = new Date(Math.round((val - 25569) * 86400 * 1000));
        return isNaN(d.getTime()) ? '' : d.toISOString().split('T')[0];
      }
      const s = String(val).trim();
      return s.length >= 10 ? s.slice(0, 10) : s;
    }

    function handleExcelImport(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = ev => {
        try {
          const wb = XLSX.read(new Uint8Array(ev.target.result), { type: 'array' });
          const ws = wb.Sheets[wb.SheetNames[0]];
          const rows = XLSX.utils.sheet_to_json(ws, { defval: '' });
          let imported = 0;

          rows.forEach((row, idx) => {
            const get = (...keys) => {
              for (const k of Object.keys(row)) {
                const cleanK = k.trim();
                if (keys.includes(cleanK)) return String(row[k]).trim();
              }
              return '';
            };
            const wo = get('رقم امر العمل', 'رقم أمر العمل');
            let contractor = get('المقاول');
            if (!wo && !contractor) return;
            if (contractor === 'العالميه') contractor = 'الشركة العالمية';
            const note = get('ملاحظة', 'ملاحظات');
            const status = note === 'تم' ? 'معتمد' : (note === 'غير معتمد' ? 'مرفوض' : (note ? 'ملاحظات معلقة' : 'قيد المراجعة'));

            // Ensure contractor exists in directory
            if (contractor && !appState.contractors.some(c => c.name === contractor)) {
              appState.contractors.push({ name: contractor, pin: '1234', active: true });
            }

            appState.invoices.unshift({
              id: 'imp_' + Date.now() + '_' + idx,
              seq: get('رقم') || (appState.invoices.length + 1),
              wo: wo || ('WO-' + idx),
              contractor: contractor || 'غير محدد',
              consultant: get('الاستشاري') || 'علوم العمران',
              invoiceDate: formatExcelDate(get('تاريخ الفاتورة')),
              workType: get('نوع العمل') || 'طوارئ',
              workDesc: get('وصف العمل') || 'فحص وصيانة معدة',
              equipType: get('نوع المعدة') || 'OH',
              funcLoc: get('الموقع الوظيفي'),
              office: get('المكتب') || 'صبيا',
              deliveryDate: formatExcelDate(get('تاريخ تسليم الفاتورة للأصول')) || todayISO(),
              note: note || 'قيد المراجعة',
              status,
              quality: get('حالة التنفيذ') || 'جيد جداً',
              checklist: {},
              photos: []
            });
            imported++;
          });

          saveState();
          refreshDynamicContractorSelects();
          logAudit('استيراد ملف Excel', `تم استيراد ${imported} سجل من الملف ${file.name}`);
          renderStaffInvoicesTable();
          showToast(`تم استيراد ${imported} فاتورة من ملف Excel وتحديث لوحة التحكم!`, 'success');
        } catch (err) {
          showToast('تعذر قراءة ملف Excel، تأكد من صيغة الملف (.xlsx)', 'error');
        }
        e.target.value = '';
      };
      reader.readAsArrayBuffer(file);
    }

    // ==================== 10. MODULE 3: REPORTS, PRINT PDF & MULTI-SHEET EXCEL ====================
    function buildScorecardData(sourceList = null) {
      const list = Array.isArray(sourceList) ? sourceList : appState.invoices;
      const map = {};
      list.forEach(i => {
        if (!map[i.contractor]) {
          map[i.contractor] = { contractor: i.contractor, total: 0, طوارئ: 0, 'صيانة معدة': 0, 'صيانة مغذي': 0, C4C: 0, approved: 0, flagged: 0 };
        }
        const m = map[i.contractor];
        m.total++;
        if (m[i.workType] !== undefined) m[i.workType]++;
        if (i.status === 'معتمد') m.approved++;
        if (i.status === 'مرفوض' || i.status === 'ملاحظات معلقة') m.flagged++;
      });
      return Object.values(map).sort((a, b) => b.total - a.total);
    }

    function renderReportsModule() {
      const rows = buildScorecardData();
      const tbody = document.getElementById('scorecardBody');
      if (!tbody) return;
      if (!rows.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="py-8 text-center text-slate-400 font-bold">لا توجد بيانات متاحة حالياً</td></tr>`;
        return;
      }
      tbody.innerHTML = rows.map(r => {
        const rate = r.total ? Math.round((r.approved / r.total) * 100) : 0;
        const barCls = rate >= 75 ? 'bg-emerald-500' : (rate >= 45 ? 'bg-amber-500' : 'bg-rose-500');
        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-3 px-4 font-extrabold text-navy-900">${escapeHtml(r.contractor)}</td>
            <td class="py-3 px-3 text-center font-black text-navy-900">${r.total}</td>
            <td class="py-3 px-3 text-center font-bold text-accent-600">${r['طوارئ']}</td>
            <td class="py-3 px-3 text-center font-bold text-navy-800">${r['صيانة معدة']}</td>
            <td class="py-3 px-3 text-center font-bold text-sky-700">${r['صيانة مغذي']}</td>
            <td class="py-3 px-3 text-center font-bold text-amber-700">${r['C4C']}</td>
            <td class="py-3 px-3 text-center font-extrabold text-emerald-700">${r.approved}</td>
            <td class="py-3 px-3 text-center font-extrabold text-rose-700">${r.flagged}</td>
            <td class="py-3 px-4">
              <div class="flex items-center gap-2">
                <div class="flex-1 h-2 bg-slate-100 rounded-full overflow-hidden">
                  <div class="h-full ${barCls} rounded-full" style="width:${rate}%"></div>
                </div>
                <span class="text-xs font-extrabold text-navy-900 w-9 text-left">${rate}%</span>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

