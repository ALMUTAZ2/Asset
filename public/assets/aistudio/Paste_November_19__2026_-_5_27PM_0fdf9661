      e.preventDefault();
      const editId = document.getElementById('cEditId').value;
      const wo = document.getElementById('cf_wo').value.trim();

      const checklist = {};
      document.querySelectorAll('.cf-check').forEach(cb => { checklist[cb.dataset.key] = cb.checked; });

      // Attempt live OneDrive upload if token exists
      if (appState.oneDrive.accessToken && pendingPhotos.length) {
        for (const p of pendingPhotos) {
          if (!p.synced) {
            p.oneDrivePath = `${appState.oneDrive.baseFolder}/${currentSession.name}/${wo}/${p.name}`;
            const uploaded = await uploadSinglePhotoToOneDrive(p);
            if (uploaded) p.synced = true;
          }
        }
      } else {
        pendingPhotos.forEach(p => {
          p.oneDrivePath = `${appState.oneDrive.baseFolder}/${currentSession.name}/${wo}/${p.name}`;
        });
      }

      const payload = {
        wo,
        contractor: currentSession.name,
        consultant: document.getElementById('cf_consultant').value,
        invoiceDate: document.getElementById('cf_invoiceDate').value,
        workType: document.getElementById('cf_workType').value,
