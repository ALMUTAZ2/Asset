    async function downloadDirectPdf() {
      const btn = document.getElementById('btnDownloadPdfDirect');
      const sourceEl = document.getElementById('printPreviewBody');
      if (!sourceEl || !sourceEl.innerHTML.trim()) {
        showToast('لا يوجد محتوى لتصديره حالياً', 'warning');
        return;
      }

      if (typeof html2pdf === 'undefined') {
        showToast('جاري فتح نافذة الطباعة لحفظ PDF...', 'info');
        triggerNativePdfPrint();
        return;
      }

      const origHtml = btn ? btn.innerHTML : '';
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>جاري تجهيز ملف PDF...</span>';
      }

      try {
        const clone = sourceEl.cloneNode(true);
        clone.style.width = '1040px';
        clone.style.padding = '20px';
        clone.style.background = '#ffffff';
        clone.style.direction = 'rtl';
        clone.style.fontFamily = 'Cairo, sans-serif';

        const opt = {
          margin: [8, 8, 8, 8],
          filename: `${currentReportFileName}.pdf`,
          image: { type: 'jpeg', quality: 0.96 },
          html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', logging: false },
          jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' },
          pagebreak: { mode: ['css', 'legacy'], before: '.page-break' }
        };

        await html2pdf().set(opt).from(clone).save();
        showToast('تم حفظ وتنزيل ملف PDF بنجاح', 'success');
      } catch (err) {
        showToast('تعذر توليد ملف PDF مباشرة، سيتم فتح نافذة الطباعة كبديل', 'warning');
        triggerNativePdfPrint();
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = origHtml;
          lucide.createIcons();
        }
      }
    }

    function triggerNativePdfPrint() {
      const content = document.getElementById('printArea').innerHTML;
      const win = window.open('', '_blank', 'width=1100,height=780');
      if (win) {
        win.document.write(`<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><title>${escapeHtml(currentReportFileName)}</title>
          <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
          <script src="https://cdn.tailwindcss.com"><\/script>
          ${getStandaloneTailwindConfigScript()}
          <style>body{font-family:'Cairo',sans-serif;padding:24px;background:#fff;color:#0f172a;-webkit-print-color-adjust:exact;print-color-adjust:exact;} .page-break{page-break-before:always;} table{border-collapse:collapse;width:100%;} tr{page-break-inside:avoid;}</style>
        </head><body>${content}<script>window.onload=function(){setTimeout(function(){window.print();},600);};<\/script></body></html>`);
        win.document.close();
      } else {
        window.print();
      }
    }

