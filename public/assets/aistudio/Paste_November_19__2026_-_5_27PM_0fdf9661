    }

    function renderDashboard() {
      const data = getFilteredDashboardInvoices();
      const filterInfo = getActiveDashFilterInfo();
      const hintEl = document.getElementById('dashActiveFilterHint');
      if (hintEl) {
        hintEl.innerHTML = `<i data-lucide="sliders-horizontal" class="w-3.5 h-3.5 text-navy-700"></i><span>نطاق التصدير الحالي (${data.length} فاتورة): <b class="text-navy-900">${escapeHtml(filterInfo.summaryText)}</b></span>`;
      }
      const total = data.length;
      const approved = data.filter(i => i.status === 'معتمد').length;
      const withNotes = data.filter(i => i.status === 'مرفوض' || i.status === 'ملاحظات معلقة').length;
      const emergency = data.filter(i => i.workType === 'طوارئ').length;
      const maintenance = data.filter(i => i.workType === 'صيانة معدة' || i.workType === 'صيانة مغذي').length;
      const c4c = data.filter(i => i.workType === 'C4C').length;
      const rate = total ? Math.round((approved / total) * 100) : 0;

      // SLA Breakdown (فواتير قيد المراجعة حسب أيام العمل بدون الجمعة والسبت)
      let slaNew = 0, slaLate = 0, slaEscalated = 0;
      data.forEach(i => {
        const cat = getInvoiceSlaInfo(i).category;
        if (cat === 'جديد') slaNew++;
        else if (cat === 'متأخر') slaLate++;
        else if (cat === 'مصعّد') slaEscalated++;
      });

      const opsCards = [
        { key: 'all', label: 'إجمالي الفواتير', val: total, sub: 'اضغط لعرض كافة الفواتير', icon: 'layers', color: 'text-navy-900 bg-navy-50' },
        { key: 'approved', label: 'معتمد', val: approved, sub: `نسبة الاعتماد: ${rate}%`, icon: 'check-circle-2', color: 'text-emerald-700 bg-emerald-50', progress: rate },
        { key: 'withNotes', label: 'عليه ملاحظة / مرفوض', val: withNotes, sub: 'يتطلب معالجة المقاول', icon: 'alert-triangle', color: 'text-rose-700 bg-rose-50' },
        { key: 'emergency', label: 'فواتير الطوارئ', val: emergency, sub: `${total ? Math.round((emergency / total) * 100) : 0}% من الإجمالي`, icon: 'zap', color: 'text-accent-600 bg-accent-50' },
        { key: 'maintenance', label: 'أعمال الصيانة', val: maintenance, sub: 'صيانة معدة + صيانة مغذي', icon: 'wrench', color: 'text-sky-700 bg-sky-50' },
        { key: 'c4c', label: 'أعمال C4C', val: c4c, sub: 'طلبات C4C المستقلة', icon: 'clipboard-list', color: 'text-amber-700 bg-amber-50' }
      ];

      const slaCards = [
        { key: 'sla_new', label: 'جديد (1 - 3 أيام عمل)', val: slaNew, sub: 'اضغط لعرض الفواتير الجديدة', icon: 'clock', border: 'border-emerald-200', badge: 'bg-emerald-50 text-emerald-700', valColor: 'text-emerald-700' },
        { key: 'sla_late', label: 'متأخر (4 - 5 أيام عمل)', val: slaLate, sub: 'اضغط لعرض الفواتير المتأخرة', icon: 'hourglass', border: 'border-amber-200', badge: 'bg-amber-50 text-amber-700', valColor: 'text-amber-700' },
        { key: 'sla_escalated', label: 'مصعّد (أكثر من 5 أيام عمل)', val: slaEscalated, sub: 'اضغط لعرض الفواتير المصعّدة', icon: 'flame', border: 'border-rose-200', badge: 'bg-rose-50 text-rose-700', valColor: 'text-rose-700' }
      ];

      document.getElementById('dashKpiGrid').innerHTML = `
        <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3.5">
          ${opsCards.map(c => {
            const activeCls = activeDashKpiKey === c.key ? 'ring-2 ring-accent-500 border-accent-500 shadow-md bg-accent-50/20' : 'border-slate-200 hover:border-accent-400 hover:shadow-md';
            return `
            <div onclick="selectDashKpiCard('${c.key}')" class="cursor-pointer bg-white rounded-2xl p-4 shadow-sm border ${activeCls} transition flex flex-col justify-between gap-2.5">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="text-[11px] font-bold text-slate-500">${c.label}</p>
                  <p class="text-2xl font-black text-navy-900 mt-1">${c.val}</p>
                </div>
                <div class="w-10 h-10 rounded-xl ${c.color} flex items-center justify-center shrink-0">
                  <i data-lucide="${c.icon}" class="w-5 h-5"></i>
                </div>
              </div>
              <div>
                <p class="text-[11px] font-semibold text-slate-500">${c.sub}</p>
                ${c.progress !== undefined ? `
                  <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden mt-1.5">
                    <div class="h-full bg-emerald-500 rounded-full" style="width:${c.progress}%"></div>
                  </div>
                ` : ''}
              </div>
            </div>
          `;
          }).join('')}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
          ${slaCards.map(s => {
            const activeCls = activeDashKpiKey === s.key ? 'ring-2 ring-accent-500 border-accent-500 shadow-md' : `${s.border} hover:shadow-md`;
            return `
            <div onclick="selectDashKpiCard('${s.key}')" class="cursor-pointer bg-white rounded-2xl p-4 shadow-sm border ${activeCls} transition flex items-center justify-between gap-3">
              <div>
                <p class="text-xs font-extrabold text-navy-900">${s.label}</p>
                <p class="text-2xl font-black ${s.valColor} mt-1">${s.val}</p>
                <p class="text-[11px] font-semibold text-slate-500 mt-0.5">${s.sub}</p>
              </div>
              <div class="w-11 h-11 rounded-2xl ${s.badge} flex items-center justify-center shrink-0">
                <i data-lucide="${s.icon}" class="w-5 h-5"></i>
              </div>
            </div>
          `;
          }).join('')}
        </div>
      `;

      // Dynamic Delay / Issue Notes from filtered data
      const noteFreq = {};
      data.forEach(i => {
        const n = (i.note || '').trim();
        if (!n || n === 'تم' || n === 'قيد المراجعة' || n === '1') return;
        noteFreq[n] = (noteFreq[n] || 0) + 1;
      });

      const top5Notes = Object.entries(noteFreq).sort((a, b) => b[1] - a[1]).slice(0, 5);

      // Top 5 contractors with the most invoices stopped/delayed by any blocking note
      const contractorDelayMap = {};
      data.forEach(i => {
        const n = (i.note || '').trim();
        const isBlocking = (n && n !== 'تم' && n !== 'قيد المراجعة' && n !== '1') || i.status === 'مرفوض' || i.status === 'ملاحظات معلقة';
        if (!isBlocking) return;
        const reason = (n && n !== 'تم' && n !== 'قيد المراجعة' && n !== '1') ? n : (i.status === 'مرفوض' ? 'مرفوض بدون ملاحظة' : 'ملاحظة معلقة');
        if (!contractorDelayMap[i.contractor]) {
          contractorDelayMap[i.contractor] = { contractor: i.contractor, total: 0, notes: {} };
        }
        contractorDelayMap[i.contractor].total++;
        contractorDelayMap[i.contractor].notes[reason] = (contractorDelayMap[i.contractor].notes[reason] || 0) + 1;
      });

      const delayByContractor = Object.values(contractorDelayMap)
        .sort((a, b) => b.total - a.total)
        .slice(0, 5)
        .map(d => {
          const sortedNotes = Object.entries(d.notes).sort((a, b) => b[1] - a[1]);
          return {
            contractor: d.contractor,
            total: d.total,
            topNote: sortedNotes[0] ? sortedNotes[0][0] : '',
            topNoteCount: sortedNotes[0] ? sortedNotes[0][1] : 0,
            sortedNotes
          };
        });

      renderDashboardCharts(data, top5Notes, delayByContractor);
      if (activeDashKpiKey) renderDashDrilldown();
      lucide.createIcons();
    }

    function destroyChart(key) {
      if (charts[key]) {
        charts[key].destroy();
        charts[key] = null;
      }
    }

    function renderDashboardCharts(data, top5Notes, delayByContractor) {
      const darkTooltip = {
        backgroundColor: '#0B2545',
        titleColor: '#ffffff',
        bodyColor: '#f8fafc',
        borderColor: '#F26522',
        borderWidth: 1,
        padding: 10,
        cornerRadius: 10,
        titleFont: { family: 'Cairo', size: 12, weight: '800' },
        bodyFont: { family: 'Cairo', size: 11, weight: '700' },
        rtl: true
      };

      const makeHBarPill = (bg, color, border) => ({
        anchor: 'end',
        align: 'right',
        offset: 8,
        clip: false,
        textAlign: 'center',
        backgroundColor: bg,
        borderColor: border,
        borderWidth: 1,
        color,
        borderRadius: 6,
        padding: { top: 2, bottom: 2, left: 8, right: 8 },
        font: { weight: '800', size: 11, family: 'Cairo' },
        formatter: val => (val > 0 ? val : '')
      });

      // 1. Contractors Stacked Bar (Ascending order + Total Pill Badge matching Offices chart)
      const cMap = {};
      data.forEach(i => {
        if (!cMap[i.contractor]) cMap[i.contractor] = { approved: 0, pending: 0, flagged: 0, total: 0 };
        cMap[i.contractor].total++;
        if (i.status === 'معتمد') cMap[i.contractor].approved++;
        else if (i.status === 'قيد المراجعة') cMap[i.contractor].pending++;
        else cMap[i.contractor].flagged++;
      });
      // Sort ascending by total count (dynamically updates when counts change)
      const cEntries = Object.entries(cMap).sort((a, b) => a[1].total - b[1].total);
      const maxContractorTotal = cEntries.length ? cEntries[cEntries.length - 1][1].total : 1;
      destroyChart('contractors');
      charts.contractors = new Chart(document.getElementById('chartContractors'), {
        type: 'bar',
        data: {
          labels: cEntries.map(e => e[0]),
          datasets: [
            { label: 'معتمد', data: cEntries.map(e => e[1].approved), backgroundColor: '#10b981', borderRadius: 4, maxBarThickness: 22 },
            { label: 'قيد المراجعة', data: cEntries.map(e => e[1].pending), backgroundColor: '#0ea5e9', borderRadius: 4, maxBarThickness: 22 },
            { label: 'مرفوض/ملاحظات', data: cEntries.map(e => e[1].flagged), backgroundColor: '#f43f5e', borderRadius: 4, maxBarThickness: 22 },
            {
              label: '__total__',
              data: cEntries.map(() => 0),
              backgroundColor: 'transparent',
              datalabels: {
                display: true,
                anchor: 'end',
                align: 'right',
                offset: 8,
                clip: false,
                textAlign: 'center',
                backgroundColor: '#eef3f9',
                borderColor: '#cbd5e1',
                borderWidth: 1,
                color: '#0B2545',
                borderRadius: 6,
                padding: { top: 2, bottom: 2, left: 8, right: 8 },
                font: { weight: '800', size: 11, family: 'Cairo' },
                formatter: (_, ctx) => cEntries[ctx.dataIndex] ? cEntries[ctx.dataIndex][1].total : ''
              }
            }
          ]
        },
        options: {
          indexAxis: 'y', responsive: true, maintainAspectRatio: false,
          layout: { padding: { right: 54 } },
          plugins: {
            legend: {
              position: 'bottom',
              labels: {
                font: { size: 11, weight: '700' },
                usePointStyle: true,
                boxWidth: 8,
                filter: item => item.text !== '__total__'
              }
            },
            tooltip: {
              ...darkTooltip,
              filter: item => item.dataset.label !== '__total__'
            },
            datalabels: {
              color: '#ffffff',
              font: { weight: '800', size: 10, family: 'Cairo' },
              display: ctx => {
                if (ctx.dataset.label === '__total__') return true;
                const v = ctx.dataset.data[ctx.dataIndex];
                return v > 0 && (v / maxContractorTotal) >= 0.06;
              },
              formatter: val => val
            }
          },
          scales: {
            x: { stacked: true, beginAtZero: true, grace: '15%', grid: { color: '#f1f5f9' }, ticks: { maxRotation: 0, autoSkip: true, font: { size: 11 } } },
            y: { stacked: true, grid: { display: false }, ticks: { font: { size: 11, weight: '700' }, color: '#0B2545' } }
          }
        }
      });

      // 2. Work Types Doughnut + Clean Breakdown Cards
      const wtMap = {};
      WORK_TYPES.forEach(w => wtMap[w] = 0);
      data.forEach(i => { wtMap[i.workType] = (wtMap[i.workType] || 0) + 1; });
      const wtColors = ['#F26522', '#0B2545', '#0ea5e9', '#f59e0b'];
      const wtTotal = data.length;
      const centerEl = document.getElementById('workTypesTotalCenter');
      if (centerEl) centerEl.textContent = wtTotal;

      const breakdownEl = document.getElementById('workTypesBreakdown');
      if (breakdownEl) {
        breakdownEl.innerHTML = WORK_TYPES.map((w, idx) => {
          const cnt = wtMap[w] || 0;
          const pct = wtTotal ? Math.round((cnt / wtTotal) * 100) : 0;
          return `
            <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200/80">
              <div class="flex items-center gap-1.5 min-w-0">
                <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${wtColors[idx]}"></span>
                <span class="text-[11px] font-extrabold text-navy-900 truncate">${escapeHtml(w)}</span>
              </div>
              <div class="text-left shrink-0 mr-1">
                <span class="text-xs font-black text-navy-900">${cnt}</span>
                <span class="text-[10px] font-bold text-slate-400">(${pct}%)</span>
              </div>
            </div>
          `;
        }).join('');
      }

      destroyChart('workTypes');
      charts.workTypes = new Chart(document.getElementById('chartWorkTypes'), {
        type: 'doughnut',
        data: {
          labels: WORK_TYPES,
          datasets: [{
            data: WORK_TYPES.map(w => wtMap[w]),
            backgroundColor: wtColors,
            borderWidth: 2,
            borderColor: '#ffffff',
            hoverOffset: 6
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false, cutout: '68%',
          plugins: {
            legend: { display: false },
            datalabels: { display: false },
            tooltip: {
              ...darkTooltip,
              callbacks: {
                label: ctx => {
                  const v = ctx.parsed || 0;
                  const pct = wtTotal ? Math.round((v / wtTotal) * 100) : 0;
                  return ` ${ctx.label}: ${v} فاتورة (${pct}%)`;
