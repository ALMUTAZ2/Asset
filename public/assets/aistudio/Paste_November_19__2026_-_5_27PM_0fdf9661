              }
            }
          },
          scales: {
            x: { beginAtZero: true, grace: '20%', grid: { color: '#f1f5f9' }, ticks: { stepSize: 1, maxRotation: 0, autoSkip: true, font: { size: 11 } } },
            y: { grid: { display: false }, ticks: { font: { size: 10.5, weight: '700' }, color: '#0B2545' } }
          }
        }
      });
    }

    // ==================== 9. MODULE 2: INVOICES MANAGEMENT & EXCEL IMPORT ====================
    function getFilteredStaffInvoices() {
      const q = (document.getElementById('invSearch').value || '').trim().toLowerCase();
      const c = document.getElementById('invFilterContractor').value;
      const o = document.getElementById('invFilterOffice').value;
      const wt = document.getElementById('invFilterWorkType').value;
      const st = document.getElementById('invFilterStatus').value;
      const slaFilter = document.getElementById('invFilterSla') ? document.getElementById('invFilterSla').value : '';

      return appState.invoices.filter(inv => {
        if (c && inv.contractor !== c) return false;
        if (o && inv.office !== o) return false;
        if (wt && inv.workType !== wt) return false;
        if (st && inv.status !== st) return false;
        if (slaFilter && getInvoiceSlaInfo(inv).category !== slaFilter) return false;
        if (q && !`${inv.wo} ${inv.contractor} ${inv.funcLoc} ${inv.workDesc} ${inv.note}`.toLowerCase().includes(q)) return false;
        return true;
      });
    }

    function renderStaffInvoicesTable() {
      const list = getFilteredStaffInvoices();
      document.getElementById('staffTableCount').textContent = list.length;
      const isViewer = currentSession.role === 'viewer';
      const tbody = document.getElementById('staffInvoicesBody');

      if (!list.length) {
        tbody.innerHTML = `<tr><td colspan="16" class="py-10 text-center text-slate-400 font-bold">لا توجد فواتير مطابقة لخيارات البحث</td></tr>`;
        return;
      }

      tbody.innerHTML = list.map(inv => {
        const photosCount = (inv.photos && inv.photos.length) || 0;
        const checked = selectedInvoiceIds.has(inv.id) ? 'checked' : '';
        const sla = getInvoiceSlaInfo(inv);
        return `
          <tr class="hover:bg-slate-50 transition">
            <td class="py-3 px-2.5"><input type="checkbox" ${checked} onchange="toggleSingleInvSelect('${inv.id}', this.checked)" class="w-4 h-4 accent-accent-500 rounded" /></td>
            <td class="py-3 px-2.5 font-mono font-extrabold text-navy-900 whitespace-nowrap" dir="ltr">${escapeHtml(inv.wo)}</td>
            <td class="py-3 px-2.5 font-bold text-navy-900 whitespace-nowrap">${escapeHtml(inv.contractor)}</td>
            <td class="py-3 px-2.5 text-slate-600 whitespace-nowrap">${escapeHtml(inv.consultant)}</td>
            <td class="py-3 px-2.5 font-mono text-xs text-slate-600 whitespace-nowrap" dir="ltr">${escapeHtml(inv.invoiceDate || '-')}</td>
            <td class="py-3 px-2.5 whitespace-nowrap">
