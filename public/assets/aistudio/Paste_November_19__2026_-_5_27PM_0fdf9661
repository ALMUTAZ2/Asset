        const newRec = { id: 'inv_' + Date.now(), seq: appState.invoices.length + 1, ...payload };
        appState.invoices.unshift(newRec);
        logAudit('رفع فاتورة جديدة', `أمر العمل ${wo} (${payload.workType}) مع ${pendingPhotos.length} صور`);
        showToast('تم رفع الفاتورة وأرشفة الصور بنجاح', 'success');
      }

      saveState();
      resetContractorForm();
      renderContractorKPIs();
      renderContractorTable();
      switchContractorTab('list');
    }

