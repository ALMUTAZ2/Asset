      OFFICES.forEach(o => offMap[o] = 0);
      data.forEach(i => { if (i.office) offMap[i.office] = (offMap[i.office] || 0) + 1; });
      const offEntries = Object.entries(offMap).sort((a, b) => b[1] - a[1]);
      destroyChart('offices');
      charts.offices = new Chart(document.getElementById('chartOffices'), {
        type: 'bar',
        data: {
          labels: offEntries.map(e => e[0]),
          datasets: [{
            label: 'عدد الفواتير',
            data: offEntries.map(e => e[1]),
            backgroundColor: '#0B2545',
            hoverBackgroundColor: '#F26522',
            borderRadius: 7,
            maxBarThickness: 32
          }]
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          layout: { padding: { top: 24 } },
          plugins: {
            legend: { display: false },
            tooltip: darkTooltip,
            datalabels: {
              anchor: 'end',
              align: 'top',
              offset: 4,
              clip: false,
              textAlign: 'center',
              backgroundColor: '#eef3f9',
              borderColor: '#cbd5e1',
              borderWidth: 1,
              color: '#0B2545',
              borderRadius: 6,
              padding: { top: 2, bottom: 2, left: 7, right: 7 },
              font: { weight: '800', size: 11, family: 'Cairo' },
              formatter: val => (val > 0 ? val : '')
            }
          },
          scales: {
            x: { grid: { display: false }, ticks: { font: { size: 11, weight: '700' }, color: '#0B2545' } },
            y: { beginAtZero: true, grace: '15%', grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 } } }
          }
        }
      });

      // 4. Top Work Descriptions Horizontal Bar
      const dMap = {};
      data.forEach(i => { dMap[i.workDesc] = (dMap[i.workDesc] || 0) + 1; });
      const dEntries = Object.entries(dMap).sort((a, b) => b[1] - a[1]).slice(0, 8);
      destroyChart('workDescs');
      charts.workDescs = new Chart(document.getElementById('chartWorkDescs'), {
        type: 'bar',
        data: {
          labels: dEntries.map(e => e[0]),
          datasets: [{
            label: 'التكرار',
            data: dEntries.map(e => e[1]),
            backgroundColor: '#F26522',
            hoverBackgroundColor: '#d95314',
            borderRadius: 7,
            maxBarThickness: 22
          }]
        },
        options: {
          indexAxis: 'y', responsive: true, maintainAspectRatio: false,
          layout: { padding: { right: 44 } },
          plugins: {
            legend: { display: false },
            tooltip: darkTooltip,
            datalabels: makeHBarPill('#fff4ee', '#b8420d', '#fed7aa')
          },
          scales: {
            x: { beginAtZero: true, grace: '20%', grid: { color: '#f1f5f9' }, ticks: { maxRotation: 0, autoSkip: true, font: { size: 11 } } },
            y: { grid: { display: false }, ticks: { font: { size: 11, weight: '700' }, color: '#0B2545' } }
          }
        }
      });

      // 5. Top Delay Root Causes Horizontal Bar
      const noteColors = ['#e11d48', '#f43f5e', '#fb7185', '#f97316', '#f59e0b'];
      destroyChart('topDelayNotes');
      charts.topDelayNotes = new Chart(document.getElementById('chartTopDelayNotes'), {
        type: 'bar',
        data: {
          labels: top5Notes.map(n => n[0]),
          datasets: [{
            label: 'عدد التكرارات',
            data: top5Notes.map(n => n[1]),
            backgroundColor: top5Notes.map((_, idx) => noteColors[idx % noteColors.length]),
            borderRadius: 7,
            maxBarThickness: 26
          }]
        },
        options: {
          indexAxis: 'y', responsive: true, maintainAspectRatio: false,
          layout: { padding: { right: 48 } },
          plugins: {
            legend: { display: false },
            tooltip: darkTooltip,
            datalabels: makeHBarPill('#fff1f2', '#be123c', '#fecdd3')
          },
          scales: {
            x: { beginAtZero: true, grace: '20%', grid: { color: '#f1f5f9' }, ticks: { stepSize: 1, maxRotation: 0, autoSkip: true, font: { size: 11 } } },
            y: { grid: { display: false }, ticks: { font: { size: 11, weight: '700' }, color: '#0B2545' } }
          }
        }
      });

      // 6. Top 5 Contractors with Most Blocking/Delay Notes & Their #1 Blocking Reason
      destroyChart('delayByContractor');
      const shortTxt = (s, max = 26) => (s && s.length > max ? s.slice(0, max) + '…' : s);
      charts.delayByContractor = new Chart(document.getElementById('chartDelayByContractor'), {
        type: 'bar',
        data: {
          labels: delayByContractor.map(d => [d.contractor, `الأبرز: ${shortTxt(d.topNote)} (${d.topNoteCount})`]),
          datasets: [{
            label: 'الفواتير المتوقفة',
            data: delayByContractor.map(d => d.total),
            backgroundColor: ['#0B2545', '#163b6b', '#e11d48', '#F26522', '#f59e0b'],
