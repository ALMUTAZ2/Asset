    function handleResetPassword(e) {
      e.preventDefault();
      const username = document.getElementById('rp_username').value.trim().toLowerCase();
      const currentPass = document.getElementById('rp_currentPass').value.trim();
      const newPass = document.getElementById('rp_newPass').value.trim();
      const confirmPass = document.getElementById('rp_confirmPass').value.trim();
      const errEl = document.getElementById('rp_error');

      const showErr = msg => {
        errEl.textContent = msg;
        errEl.classList.remove('hidden');
      };

      const staff = appState.staffUsers.find(u => u.username.toLowerCase() === username);
      if (!staff) { showErr('الرقم الوظيفي غير مسجّل في قاعدة البيانات.'); return; }
      if (staff.password !== currentPass) { showErr('كلمة المرور الحالية غير صحيحة.'); return; }
      if (newPass.length < 4) { showErr('يجب أن تكون كلمة المرور الجديدة 4 خانات على الأقل.'); return; }
      if (newPass !== confirmPass) { showErr('تأكيد كلمة المرور الجديدة غير متطابق.'); return; }

      staff.password = newPass;
      saveState();
      logAudit('إعادة تعيين كلمة المرور', `تم تحديث كلمة المرور للموظف: ${staff.name} (${staff.username})`);
