    function changeContractorPin(name) {
      const c = appState.contractors.find(x => x.name === name);
      if (!c) return;
      openConfirmModal({
        title: `تعديل الرقم السري للمقاول`,
        message: `أدخل الرقم السري (PIN) الجديد لحساب: ${name}`,
        withInput: true,
        defaultValue: c.pin,
        placeholder: 'مثال: 5588',
        onConfirm: newPin => {
          if (!newPin) return;
          c.pin = newPin;
          saveState();
          logAudit('تعديل PIN مقاول', `تم تحديث الرقم السري للمقاول: ${name}`);
          renderUsersManagement();
          showToast(`تم تحديث الرقم السري لـ ${name}`, 'success');
        }
      });
    }

    function toggleContractorActive(name) {
      const c = appState.contractors.find(x => x.name === name);
      if (!c) return;
      c.active = !c.active;
      saveState();
      logAudit('تغيير حالة مقاول', `${name} ⇐ ${c.active ? 'تفعيل' : 'إيقاف'}`);
      renderUsersManagement();
      showToast(`تم ${c.active ? 'تفعيل' : 'إيقاف'} حساب ${name}`, 'info');
    }

    function addNewContractorPrompt() {
      openConfirmModal({
        title: 'إضافة مقاول جديد للمنصة',
        message: 'أدخل اسم الشركة أو المؤسسة الجديدة (سيكون الرقم السري الافتراضي 1234):',
        withInput: true,
        placeholder: 'مثال: شركة النور للمقاولات الكهربائية',
        onConfirm: name => {
          if (!name) return;
          if (appState.contractors.some(c => c.name === name)) {
            showToast('هذا المقاول مسجل مسبقاً', 'warning');
            return;
          }
          appState.contractors.unshift({ name, pin: '1234', active: true });
          saveState();
          refreshDynamicContractorSelects();
          logAudit('إضافة مقاول', `تمت إضافة المقاول: ${name}`);
          renderUsersManagement();
          showToast(`تمت إضافة ${name} بنجاح`, 'success');
        }
      });
    }

    function addStaffUser(e) {
      e.preventDefault();
      const name = document.getElementById('newStaffName').value.trim();
      const username = document.getElementById('newStaffUser').value.trim();
      const password = document.getElementById('newStaffPass').value.trim();
      const role = document.getElementById('newStaffRole').value;
      if (appState.staffUsers.some(u => u.username.toLowerCase() === username.toLowerCase())) {
        showToast('اسم المستخدم موجود مسبقاً', 'error');
        return;
      }
      appState.staffUsers.push({ id: 'st_' + Date.now(), name, username, password, role });
      saveState();
      logAudit('إضافة موظف', `حساب جديد: ${name} (${username})`);
      e.target.reset();
      renderUsersManagement();
      showToast('تم إنشاء حساب الموظف بنجاح', 'success');
    }

    function removeStaffUser(id) {
      appState.staffUsers = appState.staffUsers.filter(u => u.id !== id);
      saveState();
      renderUsersManagement();
      showToast('تم حذف حساب الموظف', 'info');
    }

    function changeStaffRole(id, newRole) {
      const user = appState.staffUsers.find(u => u.id === id);
      if (!user || user.username === '100889') return;
      const roleAr = { admin: 'مدير نظام (كامل)', reviewer: 'موظف شركة (مراجعة واعتماد)', viewer: 'مراقب (عرض وتقارير)' };
      user.role = newRole;
      saveState();
      logAudit('تعديل صلاحية موظف', `تم تغيير صلاحية ${user.name} (${user.username}) إلى: ${roleAr[newRole] || newRole}`);
      renderUsersManagement();
      showToast(`تم تحديث صلاحية ${user.name} إلى ${roleAr[newRole] || newRole}`, 'success');
    }

    // ==================== 12. MODULE 5: MICROSOFT ONEDRIVE INTEGRATION ====================
    function renderOneDriveModule() {
      document.getElementById('odClientId').value = appState.oneDrive.clientId || '';
      document.getElementById('odTenantId').value = appState.oneDrive.tenantId || 'common';
      document.getElementById('odBaseFolder').value = appState.oneDrive.baseFolder || '/فواتير_الصيانة_والطوارئ';
      document.getElementById('odAccessToken').value = appState.oneDrive.accessToken || '';
      updateOneDriveBadges();

      // Build Folder Tree Preview
      const tree = {};
      let totalPhotos = 0;
      appState.invoices.forEach(inv => {
        if (inv.photos && inv.photos.length) {
          if (!tree[inv.contractor]) tree[inv.contractor] = {};
          tree[inv.contractor][inv.wo] = inv.photos;
          totalPhotos += inv.photos.length;
        }
      });
      document.getElementById('odTotalPhotosCount').textContent = totalPhotos;

      let lines = [`📁 OneDrive${appState.oneDrive.baseFolder}`];
      Object.entries(tree).slice(0, 6).forEach(([contractor, wos]) => {
        lines.push(`  ├─ 📂 ${contractor}`);
        Object.entries(wos).slice(0, 3).forEach(([wo, photos]) => {
          lines.push(`  │   ├─ 📂 ${wo}`);
          photos.forEach(p => {
            lines.push(`  │   │   └─ 🖼️ ${p.name} ${p.synced ? '[Synced ✓]' : '[Local]'}`);
          });
        });
      });
      document.getElementById('odFolderTreePreview').innerHTML = lines.map(l => `<div class="whitespace-pre">${escapeHtml(l)}</div>`).join('');
    }

    function updateOneDriveBadges() {
      const connected = !!(appState.oneDrive.accessToken && appState.oneDrive.connectedUser);
      const odBadge = document.getElementById('odStatusBadge');
      if (odBadge) {
        odBadge.textContent = connected ? `متصل (${appState.oneDrive.connectedUser})` : 'غير متصل';
        odBadge.className = connected
          ? 'text-xs font-extrabold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800'
          : 'text-xs font-extrabold px-3 py-1 rounded-full bg-amber-100 text-amber-800';
      }
      lucide.createIcons();
    }

    function saveOneDriveConfig() {
      appState.oneDrive.clientId = document.getElementById('odClientId').value.trim();
      appState.oneDrive.tenantId = document.getElementById('odTenantId').value.trim() || 'common';
      appState.oneDrive.baseFolder = document.getElementById('odBaseFolder').value.trim() || '/فواتير_الصيانة_والطوارئ';
      appState.oneDrive.accessToken = document.getElementById('odAccessToken').value.trim();
      saveState();
      renderOneDriveModule();
      showToast('تم حفظ إعدادات OneDrive بنجاح', 'success');
    }

    function connectOneDriveOAuth() {
      saveOneDriveConfig();
      if (!appState.oneDrive.clientId) {
        showToast('يرجى إدخال Client ID الخاص بتطبيق Azure أولاً (أو لصق Access Token مباشرة)', 'warning');
        return;
      }
      const redirectUri = window.location.origin + window.location.pathname;
      const scope = encodeURIComponent('Files.ReadWrite User.Read');
      const authUrl = `https://login.microsoftonline.com/${encodeURIComponent(appState.oneDrive.tenantId)}/oauth2/v2.0/authorize?client_id=${encodeURIComponent(appState.oneDrive.clientId)}&response_type=token&redirect_uri=${encodeURIComponent(redirectUri)}&scope=${scope}`;
      window.open(authUrl, 'OneDriveOAuth', 'width=560,height=680');
      showToast('تم فتح نافذة تسجيل الدخول إلى Microsoft OneDrive', 'info');
    }

    async function verifyOneDriveToken() {
      saveOneDriveConfig();
      if (!appState.oneDrive.accessToken) {
        showToast('لا يوجد رمز وصول (Access Token) لفحصه حالياً', 'warning');
        return;
      }
      try {
        const res = await fetch('https://graph.microsoft.com/v1.0/me/drive', {
          headers: { Authorization: `Bearer ${appState.oneDrive.accessToken}` }
        });
        if (!res.ok) throw new Error('Unauthorized');
        const info = await res.json();
        appState.oneDrive.connectedUser = info.owner?.user?.displayName || 'حساب OneDrive';
        saveState();
        updateOneDriveBadges();
        logAudit('ربط OneDrive', `تم التحقق من الاتصال بحساب: ${appState.oneDrive.connectedUser}`);
        showToast(`تم الاتصال بنجاح بحساب OneDrive: ${appState.oneDrive.connectedUser}`, 'success');
      } catch (err) {
        appState.oneDrive.connectedUser = '';
        saveState();
        updateOneDriveBadges();
        showToast('فشل التحقق من الاتصال: تأكد من صلاحية Access Token', 'error');
      }
    }

    async function uploadSinglePhotoToOneDrive(photo) {
      if (!appState.oneDrive.accessToken) return false;
      try {
        const blob = await (await fetch(photo.dataUrl)).blob();
        const cleanPath = photo.oneDrivePath.replace(/^\/+/, '');
        const url = `https://graph.microsoft.com/v1.0/me/drive/root:/${encodeURI(cleanPath)}:/content`;
        const res = await fetch(url, {
          method: 'PUT',
          headers: { Authorization: `Bearer ${appState.oneDrive.accessToken}`, 'Content-Type': blob.type || 'image/jpeg' },
          body: blob
        });
        return res.ok;
      } catch (e) {
        return false;
      }
    }

    async function syncLocalPhotosToOneDrive() {
      if (!appState.oneDrive.accessToken) {
        showToast('يرجى ربط حساب OneDrive أولاً لإتمام المزامنة السحابية', 'warning');
        return;
      }
      let syncedCount = 0;
      for (const inv of appState.invoices) {
        for (const p of (inv.photos || [])) {
          if (!p.synced) {
            const ok = await uploadSinglePhotoToOneDrive(p);
            if (ok) { p.synced = true; syncedCount++; }
          }
        }
      }
      saveState();
      renderOneDriveModule();
      logAudit('مزامنة OneDrive', `تم رفع ومزامنة ${syncedCount} صورة إلى OneDrive`);
      showToast(syncedCount ? `تمت مزامنة ${syncedCount} صورة إلى OneDrive بنجاح` : 'كافة الصور متزامنة أو تعذر الرفع', syncedCount ? 'success' : 'info');
    }

    // ==================== 13. INITIALIZATION ====================
    function enableDragScroll(el) {
      if (!el || el.dataset.dragInit) return;
      el.dataset.dragInit = '1';
      let isDown = false, startX = 0, startY = 0, scrollLeft = 0, scrollTop = 0;

      el.addEventListener('mousedown', e => {
        if (e.target.closest('button, a, input, select, textarea, label')) return;
        isDown = true;
        el.classList.add('is-dragging');
        startX = e.pageX - el.offsetLeft;
        startY = e.pageY - el.offsetTop;
        scrollLeft = el.scrollLeft;
        scrollTop = el.scrollTop;
      });
      const stopDrag = () => {
        isDown = false;
        el.classList.remove('is-dragging');
      };
      el.addEventListener('mouseleave', stopDrag);
      el.addEventListener('mouseup', stopDrag);
      el.addEventListener('mousemove', e => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - el.offsetLeft;
        const y = e.pageY - el.offsetTop;
        el.scrollLeft = scrollLeft - (x - startX) * 1.25;
        el.scrollTop = scrollTop - (y - startY) * 1.25;
      });
    }

    document.addEventListener('click', e => {
      const dd = document.getElementById('contractorDropdownList');
      const inp = document.getElementById('contractorSearchInput');
      if (dd && inp && !dd.contains(e.target) && !inp.contains(e.target)) {
        dd.classList.add('hidden');
      }
    });

    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      populateStaticSelects();

      // Check OAuth implicit hash return from Microsoft OneDrive
      if (window.location.hash && window.location.hash.includes('access_token=')) {
        const params = new URLSearchParams(window.location.hash.substring(1));
        const token = params.get('access_token');
        if (token) {
          appState.oneDrive.accessToken = token;
          saveState();
          window.history.replaceState(null, '', window.location.pathname);
          verifyOneDriveToken();
        }
      }

      lucide.createIcons();
    });
  </script>
